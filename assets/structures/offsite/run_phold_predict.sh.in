#!/usr/bin/env bash
#
# Offsite GPU script — runs `phold proteins-predict` on each shard FASTA
# under shards/ and writes one prediction dir per shard under outputs/.
#
# Generated by PACKAGE_PHOLD_OFFSITE inside the metagear `structures`
# workflow. Designed to be run on any machine with a CUDA-capable GPU
# and the `phold` binary on PATH (e.g. a micromamba env with
# `phold=__PHOLD_VERSION__` installed, or a Pyxis-launched container shell).
#
# Usage:
#   bash run_phold_predict.sh --phold-db /path/to/phold_db [options]
#
# Options:
#   --phold-db PATH        Required. Local PHOLD DB directory on this server.
#                          Must already contain models--Rostlab--ProstT5_fp16/
#                          and the all_phold_structures* files (i.e. the
#                          full PHOLD install).
#   --batch-size N         ProstT5 batch size. Default 8. Bump for big GPUs
#                          (V100/A100/H100 with >= 16 GB VRAM can handle 16+).
#                          Drop to 1 on small GPUs (e.g. 8 GB consumer cards).
#   --threads N            CPU threads for data loading + Foldseek inside
#                          predict. Default 6.
#   --resume               Skip shards whose output dir already contains
#                          phold_aa.fasta (idempotent re-run).
#   --dry-run              Print what would be run but don't execute.
#   -h, --help             This message.
#
# Generated for:
#   metagear-pipeline-dev commit __PIPELINE_COMMIT__
#   structures_scope       __STRUCTURES_SCOPE__
#   N shards               __NUM_SHARDS__
#   created                __CREATED_AT__
#
# After running, rsync outputs/ back to the source machine's
# <metagear-outdir>/structures/phold_predict/ and re-invoke `metagear
# structures` with the same arguments minus --structures_prepare_for_gpu;
# auto-reuse will pick up the predict outputs and resume the workflow.

set -euo pipefail

PHOLD_DB=""
BATCH_SIZE=8
THREADS=6
RESUME=0
DRY_RUN=0

usage() {
    sed -n '2,/^set -euo pipefail$/{/^set/!p}' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

while (( $# > 0 )); do
    case "$1" in
        --phold-db)   PHOLD_DB="$2"; shift 2;;
        --batch-size) BATCH_SIZE="$2"; shift 2;;
        --threads)    THREADS="$2"; shift 2;;
        --resume)     RESUME=1; shift;;
        --dry-run)    DRY_RUN=1; shift;;
        -h|--help)    usage 0;;
        *) echo "Unknown option: $1" >&2; usage 1;;
    esac
done

[ -n "$PHOLD_DB" ] || { echo "ERROR: --phold-db is required" >&2; usage 1; }
[ -d "$PHOLD_DB" ] || { echo "ERROR: PHOLD DB not found at: $PHOLD_DB" >&2; exit 1; }

# Sanity-check the DB looks like a complete install
for f in models--Rostlab--ProstT5_fp16 all_phold_structures all_phold_structures.dbtype; do
    [ -e "$PHOLD_DB/$f" ] || {
        echo "ERROR: PHOLD DB at '$PHOLD_DB' missing expected entry '$f'." >&2
        echo "       This isn't a complete PHOLD install. Run \`phold install -d $PHOLD_DB\` first." >&2
        exit 1
    }
done

command -v phold >/dev/null || {
    echo "ERROR: 'phold' not on PATH." >&2
    echo "       Activate your env first, e.g.:" >&2
    echo "         micromamba activate metagear-structures   # or whatever you named it" >&2
    exit 1
}

# Disable hf-xet (same workaround as the metagear pipeline's PHOLD_PREDICT
# module): the Rust-based hf-xet downloader panics inside minimal
# containers when no system CA roots are present. PHOLD doesn't need HF
# at runtime as long as the DB is local, but the env var keeps things
# safe.
export HF_HUB_DISABLE_XET=1

mkdir -p outputs
shards=( shards/*.faa.gz )
[ -e "${shards[0]}" ] || { echo "ERROR: no shards/*.faa.gz found" >&2; exit 1; }

total=${#shards[@]}
echo "[offsite-predict] phold $(phold --version 2>&1 | sed 's/^phold, version //')"
echo "[offsite-predict] phold_db    = $PHOLD_DB"
echo "[offsite-predict] batch_size  = $BATCH_SIZE"
echo "[offsite-predict] threads     = $THREADS"
echo "[offsite-predict] shards      = $total"
echo "[offsite-predict] resume      = $RESUME"
[ $DRY_RUN -eq 1 ] && echo "[offsite-predict] DRY RUN (no commands will be executed)"
echo

i=0
done_count=0
skipped=0
for shard in "${shards[@]}"; do
    i=$(( i + 1 ))
    name=$(basename "$shard" .faa.gz)
    out_dir="outputs/predict_${name}"

    if [ $RESUME -eq 1 ] && [ -f "$out_dir/phold_aa.fasta" ]; then
        echo "[$i/$total] skip $name (resume — already done)"
        skipped=$(( skipped + 1 ))
        continue
    fi

    echo "[$i/$total] run $name"
    cmd=(phold proteins-predict
        -i "$shard"
        -o "$out_dir"
        -d "$PHOLD_DB"
        --batch_size "$BATCH_SIZE"
        -t "$THREADS")

    if [ $DRY_RUN -eq 1 ]; then
        printf "    %q " "${cmd[@]}"; echo
    else
        rm -rf "$out_dir"   # phold's --force flag has quirks; remove cleanly
        "${cmd[@]}"
        done_count=$(( done_count + 1 ))
    fi
done

echo
echo "[offsite-predict] done — $done_count completed, $skipped skipped"
echo
echo "Next steps:"
echo "  1. Verify every shard produced an output:"
echo "       ls outputs/predict_*/phold_aa.fasta | wc -l   # expect $total"
echo "  2. Rsync outputs/ back to the source machine, into"
echo "     <metagear-outdir>/structures/phold_predict/:"
echo "       rsync -avzP outputs/ <user>@<source-host>:/<outdir>/structures/phold_predict/"
echo "  3. Re-invoke metagear with the same args minus --structures_prepare_for_gpu;"
echo "     auto-reuse will pick up the predict outputs and resume the workflow."
