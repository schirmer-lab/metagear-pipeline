{
    "metagear": {
        "workflows": {
            "global_parameters": [
                { "name": "outdir", "required": false, "default": "results", "description": "Output directory" },
                { "name": "help", "required": false, "description": "Display help information" },
                { "name": "debug", "required": false, "default": false, "description": "Enable debug mode" },
                { "name": "config", "required": false, "description": "Custom configuration file" }
            ],
            "definitions": [
                {
                    "name": "download_databases",
                    "description": "Install Databases (Kneaddata, MetaPhlAn, HUMAnN)",
                    "parameters": [
                        { "name": "databases", "required": false, "default": "all", "description": "Databases to install (default: all, gene_analysis, viral_analysis)" }
                    ]
                },
                {
                    "name": "qc_dna",
                    "description": "Quality Control for DNA",
                    "parameters": [
                        { "name": "input", "required": true, "description": "Input .csv file for quality control" }
                    ]
                },
                {
                    "name": "qc_rna",
                    "description": "Quality Control for RNA",
                    "parameters": [
                        { "name": "input", "required": true, "description": "Input .csv file for quality control" }
                    ]
                },
                {
                    "name": "microbial_profiles",
                    "description": "Get microbial profiles with MetaPhlAn and HUMAnN",
                    "parameters": [
                        { "name": "input", "required": true, "description": "Input .csv file for microbial profiles" }
                    ]
                },
                {
                    "name": "gene_analysis",
                    "description": "Gene centric analysis workflow",
                    "parameters": [
                        { "name": "input", "required": true, "description": "Input .csv file for gene analysis" },
                        {
                            "name": "contigs_dir",
                            "required": false,
                            "description": "Contigs catalog (if available)"
                        },
                        {
                            "name": "metaphlan_profiles",
                            "required": false,
                            "description": "MetaPhlAn profiles (if available)"
                        }
                    ]
                },
                {
                    "name": "viral_analysis",
                    "description": "Viral analysis workflow",
                    "parameters": [
                        { "name": "input", "required": true, "description": "Input .csv file for viral analysis" },
                        {
                            "name": "contigs_dir",
                            "required": false,
                            "description": "Contigs (DIRECTORY: optional). Folder containing SAMPLE_ID.contigs.fa.gz files"
                        },
                        {
                            "name": "genes_dir",
                            "required": false,
                            "description": "Genes (DIRECTORY: optional). Folder containing SAMPLE_ID.all.genes.filtered.fasta files"
                        },
                        {
                            "name": "all_genes",
                            "required": false,
                            "description": "All-genes catalog (FILE: optional). Concatenated genes from all samples."
                        },
                        {
                            "name": "representative_genes",
                            "required": false,
                            "description": "Representative-genes catalog (FILE: optional). Dereplicated genes from all samples."
                        },
                        {
                            "name": "representative_proteins",
                            "required": false,
                            "description": "Representative-proteins catalog (FILE: optional). Dereplicated proteins from all samples."
                        },
                        {
                            "name": "representative_proteins_annotations",
                            "required": false,
                            "description": "Representative-proteins annotations (FILE: optional). Functional annotations for representative proteins."
                        },
                        {
                            "name": "viral_annotation",
                            "required": false,
                            "description": "Perform viral annotation (default: true)."
                        }
                    ]
                }
            ]
        }
    }
}
