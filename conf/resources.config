        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'CLASSIFY_GENES' {
        // Pure-python single-pass over the cohort gene clusters TSV (~1.2M rows / 90 MB on HMP2). Memory footprint dominated by the contig→class dict (millions of contigs × ~50 bytes ≈ few hundred MB).
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'MMSEQS_DATABASES' {
        // One-time setup: downloads + indexes GTDB taxonomy DB via `mmseqs databases GTDB`. The 24h ceiling allows for ~30-50 GB download on a slow link plus index build.
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
