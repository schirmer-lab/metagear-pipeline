    }

    withName: 'SKANI_TRIANGLE' {
        // "Bulk pairwise ANI over all cohort bins (sparse output). O(N^2) pairs but skani's per-pair cost is ~1000× cheaper than dRep's full pipeline
        cpus   = { 16 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: 'BATCH_BINS' {
