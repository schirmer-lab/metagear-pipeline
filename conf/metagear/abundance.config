process {

    // Note: contig-mode ABUNDANCE outputs land under abundance/<class>/. Each
    // catalog (all.genes, virus, plasmid) gets its own self-contained subtree:
    //
    //   abundance/<class>/
    //   ├── bwa_index/                  ← from BWA_INDEX (this block)
    //   ├── bams/                       ← from COVERM_MAKE (next block)
    //   │   └── SAMPLE-N.bam
    //   ├── <class>.count.tsv           ← from COVERM_CONTIG_MERGE (4th block)
    //   ├── <class>.rpkm.tsv
    //   └── <class>.tpm.tsv
    //
    // Per-batch COVERM_CONTIG outputs (the inputs to the merge) are
    // pipeline-internal and dropped from publish — see the 3rd block.

    withName: '.*:BWA_INDEX' {


        publishDir = [
            path: { "${params.outdir}/abundance/${meta.id}/bwa_index" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_MAKE' {
        ext.args = "-p bwa-mem"


        // Work-dir filenames look like "<class>/SAMPLE-N.bam". Insert "bams/"
        // between the class and the BAM file so they land at
        //   abundance/<class>/bams/SAMPLE-N.bam
        // separate from the BWA index alongside.
        publishDir = [
            path: { "${params.outdir}/abundance" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename.replaceFirst(/^([^\/]+)\//, '$1/bams/')
            }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_CONTIG' {
        ext.args = "--min-read-percent-identity 95 --min-read-aligned-percent 75" // Count
        ext.args2 = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 20" // RPKM, TPM


        // Per-batch coverm-contig matrices feed into COVERM_CONTIG_MERGE.
        // Kept in the published tree (under per_batch/) as provenance for
        // the merged matrices — lets future verification scripts catch
        // partial merges, missing samples, or schema drift even after the
        // Nextflow work dir is cleaned. meta.id = "<class>_NNN" (batch
        // tag), meta.label = "<class>". Rename to batch_NNN.<metric>.tsv
        // since the class is already in the parent path.
        publishDir = [
            path: { "${params.outdir}/abundance/${meta.label}/per_batch" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_NNN.abundance_<metric>.tsv  →  batch_NNN.<metric>.tsv
                return filename.replaceFirst(
                    /^[^_]+(?:\.[^_]+)*_(\d+)\.abundance_([^.]+)\.tsv$/,
                    'batch_$1.$2.tsv'
                )
            }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_CONTIG_MERGE' {

        // Merged abundance matrices — the actual ABUNDANCE deliverables.
        // meta.id is "<class>_<metric>" (e.g. all.genes_count, virus_rpkm);
        // route to abundance/<class>/ and rename to "<class>.<metric>.tsv".
        // Cohort_dereplication has its own COVERM_CONTIG_MERGE override
        // (cohort_dereplication.config) so this doesn't apply there.
        publishDir = [
            path: {
                def cls = meta.id.replaceFirst(/_(count|rpkm|tpm)$/, '')
                "${params.outdir}/abundance/${cls}"
            },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_<metric>_merged.tsv  →  <class>.<metric>.tsv
                return filename.replaceFirst(/_(count|rpkm|tpm)_merged\.tsv$/, '.$1.tsv')
            }
        ]
    }
}
