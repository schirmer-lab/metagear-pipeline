process {

    withName: '.*:BWA_INDEX' {


        publishDir = [
            path: { "${params.outdir}/abundance/${meta.id}/bwa_index" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_MAKE' {
        ext.args = "-p bwa-mem"


        // Work-dir names are "<class>/SAMPLE-N.bam"; insert bams/ to keep them
        // separate from the BWA index alongside.
        publishDir = [
            path: { "${params.outdir}/abundance" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename.replaceFirst(/^([^\/]+)\//, '$1/bams/')
            }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_CONTIG' {
        // methods use args, methods2 use args2. covered_bases must not be gated by
        // --min-covered-fraction: that would zero the values a detection rule tests.
        ext.methods  = ['count', 'covered_bases']
        ext.methods2 = ['rpkm', 'tpm']

        ext.args = "--min-read-percent-identity 95 --min-read-aligned-percent 75" // count, covered_bases
        ext.args2 = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 20" // RPKM, TPM


        // The merge inputs are published as provenance, so a partial merge or a
        // missing sample is still detectable after the work dir is cleaned.
        publishDir = [
            path: { "${params.outdir}/abundance/${meta.label}/per_batch" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_NNN.abundance_<metric>.tsv  →  batch_NNN.<metric>.tsv
                return filename.replaceFirst(
                    /^[^_]+(?:\.[^_]+)*_(\d+)\.abundance_([^.]+)\.tsv$/,
                    'batch_$1.$2.tsv'
                )
            }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_CONTIG_MERGE' {

        // MAG has its own COVERM_CONTIG_MERGE override in mag.config, so this
        // does not apply there.
        publishDir = [
            path: {
                def cls = meta.id.replaceFirst(/_(count|rpkm|tpm|covered_bases)$/, '')
                "${params.outdir}/abundance/${cls}"
            },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_<metric>_merged.tsv  →  <class>.<metric>.tsv
                return filename.replaceFirst(/_(count|rpkm|tpm|covered_bases)_merged\.tsv$/, '.$1.tsv')
            }
        ]
    }
}
