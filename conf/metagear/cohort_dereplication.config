// Workflow-level config for the `cohort_dereplication` entry workflow.
//
// Inputs (params): see workflow_definitions.json. Reuses bin and per-contig
// TSV outputs from a prior `integrated_classification` run.

process {

    // ─── Per-sample renamer + genomeInfo slice ───────────────────────────────
    withName: '.*:COHORT_DEREPLICATION:PREPARE_DREP_INPUTS' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/renamed_bins/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('_ginfo.csv') ? null : filename }
        ]
    }

    // ─── dRep ────────────────────────────────────────────────────────────────
    // --S_algorithm skani:       fast secondary clustering (vs the default
    //                            ANImf). Equivalent ANI accuracy at the 95%
    //                            species threshold.
    // --genomeInfo drep_work/…:  STAGE_DREP_WORK pre-stages the cohort
    //                            genomeInfo CSV inside drep_work/. Passing
    //                            this lets dRep skip its internal CheckM run
    //                            (we already have Binette's CheckM2 numbers).
    // -comp 50 / -con 10:        MIMAG MQ+ inclusion threshold. Binette
    //                            already filters at --min_completeness 50;
    //                            -con 10 lets a few mildly contaminated MQ
    //                            bins through that Binette would otherwise
    //                            keep but you'd want to flag.
    // Dual publishDir splits dRep outputs by audience:
    //   assemblies/dereplicated/<file>.fa        (cluster-winner MAG sequences)
    //   cohort_dereplication/drep/{data_tables,figures,log,logger.log}/  (rest)
    //
    // The data_tables/ subdir (Cdb.csv, Wdb.csv, etc.) and figures/ stay in
    // cohort_dereplication/ since they're cohort-level tables, not sequence
    // deliverables. FASTAs concentrate under assemblies/ alongside the
    // per-sample bins and the cohort catalog.
    withName: '.*:COHORT_DEREPLICATION:DREP_DEREPLICATE' {

        ext.args = '--S_algorithm skani --genomeInfo drep_work/genomeInfo.csv -comp 50 -con 10'

        publishDir = [
            // → assemblies/dereplicated/   (cluster winners)
            [
                path  : { "${params.outdir}/assemblies/dereplicated" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // DREP_DEREPLICATE emits dereplicated_genomes/*.fa.
                    // Strip the subdir prefix so files sit directly under
                    // assemblies/dereplicated/.
                    if (filename.startsWith('dereplicated_genomes/'))
                        return filename.replaceFirst(/^dereplicated_genomes\//, '')
                    return null
                }
            ],
            // → cohort_dereplication/drep/   (cluster tables, figures, log)
            [
                path  : { "${params.outdir}/cohort_dereplication/drep" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // Skip the dereplicated FASTAs (handled by the first publishDir).
                    if (filename.startsWith('dereplicated_genomes/')) return null
                    return filename
                }
            ]
        ]
    }

    // ─── Cohort MAG catalog (FASTA + lookups) ────────────────────────────────
    // Moves out of cohort_dereplication/catalog/ to live alongside the other
    // assembly-derived sequence deliverables under assemblies/.
    withName: '.*:COHORT_DEREPLICATION:BUILD_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/assemblies/catalog" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Cohort abundance (genome mode) ──────────────────────────────────────
    // BWA_INDEX / COVERM_MAKE are shared with the contig-mode ABUNDANCE flow
    // used by gene_analysis + viral_analysis — that's the whole point of
    // reusing the subworkflow. Scope publishDir to this entry workflow so the
    // MAG matrices land in a cohort_dereplication/ subtree.

    // Scoped BWA_INDEX so the cohort MAG-catalog index doesn't leak into
    // ${outdir}/coverm/ (abundance.config's bare `.*:BWA_INDEX` pattern would
    // otherwise route it there). meta.id at this point is 'cohort_mag_catalog'.
    withName: '.*:COHORT_DEREPLICATION:.*:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/bwa_index/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:COHORT_DEREPLICATION:.*:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:COHORT_DEREPLICATION:.*:COVERM_GENOME' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/abundance/per_batch" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:COHORT_DEREPLICATION:.*:COVERM_CONTIG_MERGE' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/abundance" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── GTDB-Tk on cluster representatives ──────────────────────────────────
    // dRep emits winners as <sample>.binette_binN.fa (the renamed form from
    // PREPARE_DREP_INPUTS), so the FASTA suffix is 'fa', not 'fasta'.
    withName: '.*:COHORT_DEREPLICATION:GTDBTK_CLASSIFYWF' {

        ext.extension = 'fa'

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/gtdbtk" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-sample TSV enrichment ───────────────────────────────────────────
    withName: '.*:COHORT_DEREPLICATION:ENRICH_PER_CONTIG_TSV' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication/per_contig_enriched" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Cohort catalog summary ──────────────────────────────────────────────
    withName: '.*:COHORT_DEREPLICATION:SUMMARIZE_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/cohort_dereplication" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
