process {

    // Explicit overrides: without them modules.config's default publishDir puts
    // these staging outputs at the top of the user-visible tree.
    withName: '.*:MAG:STAGE_DREP_WORK'    { publishDir = [ enabled: false ] }
    withName: '.*:MAG:GATHER_GENOMES_DIR' { publishDir = [ enabled: false ] }

    // Batch provenance is not lost by leaving these unpublished: MERGE_DREP_TABLES
    // carries batch_id into the cohort table. The threshold itself is documented
    // where it is declared, in common.config.
    withName: '.*:MAG:BATCH_BINS' {
        publishDir = [ enabled: false ]
        ext.args   = "--ani-threshold ${params.drep_batch_ani}"
    }

    withName: '.*:MAG:SKANI_TRIANGLE' {

        // Keep every pair regardless of alignment fraction, so BATCH_BINS sees
        // true singletons and applies the one ANI threshold itself.
        ext.args = "--min-af 0"

        publishDir = [
            path: { "${params.outdir}/mag/drep/skani" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --S_algorithm skani is chosen over the default ANImf for speed at equal
    // accuracy around the 95% species threshold. --genomeInfo lets dRep skip its
    // own CheckM, since Binette's CheckM2 numbers are already staged. -comp 50
    // and -con 10 are the MIMAG medium-quality bounds.
    withName: '.*:MAG:DREP_DEREPLICATE' {

        // The doubled path in --genomeInfo is not a typo: stageAs 'drep_work/'
        // keeps the source directory name inside the target, so BATCH_BINS's
        // drep_work_seed/ ends up nested one level down.
        ext.args = '--S_algorithm skani --genomeInfo drep_work/drep_work_seed/genomeInfo.csv -comp 50 -con 10'

        publishDir = [
            // Winners collide across batches only if bins are unprefixed;
            // Binette's --prefix already makes each basename unique.
            [
                path  : { "${params.outdir}/assemblies/dereplicated" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.startsWith('dereplicated_genomes/'))
                        return filename.replaceFirst(/^dereplicated_genomes\//, '')
                    return null
                }
            ],
            [
                path  : { "${params.outdir}/mag/drep/per_batch/${meta.id}" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.startsWith('dereplicated_genomes/')) return null
                    return filename
                }
            ]
        ]
    }

    withName: '.*:MAG:MERGE_DREP_TABLES' {

        publishDir = [
            path: { "${params.outdir}/mag/drep" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Published under catalogs/ because this is the cohort representative set;
    // the per-genome FASTAs stay under assemblies/ for tools that want a
    // directory of files.
    withName: '.*:MAG:BUILD_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/catalogs/mag" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Renamed to match the representative-FASTA naming in catalogs/.
                if (filename == 'mag_catalog.fa.gz') return 'mag.representative.fa.gz'
                return filename
            }
        ]
    }

    // These processes are shared with the contig-mode ABUNDANCE flow, so the
    // selectors are MAG-scoped and the outputs are routed to abundance/mag/ in
    // the same shape as the other classes.
    withName: '.*:MAG:.*:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/abundance/mag/bwa_index" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MAG:.*:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/abundance/mag/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MAG:.*:COVERM_GENOME' {

        // The explicit 0 is required: coverm genome defaults
        // --min-covered-fraction to 0.10 and refuses to run count with a nonzero
        // value, where coverm contig defaults it to 0.
        ext.args  = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 0"   // count
        ext.args2 = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 20"  // rpkm, tpm

        publishDir = [
            path: { "${params.outdir}/abundance/mag/per_batch" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_NNN.abundance_<metric>.tsv  →  batch_NNN.<metric>.tsv
                return filename.replaceFirst(/^[^_]+(?:\.[^_]+)*_(\d+)\.abundance_([^.]+)\.tsv$/, 'batch_$1.$2.tsv')
            }
        ]
    }

    withName: '.*:MAG:.*:COVERM_CONTIG_MERGE' {

        publishDir = [
            path: { "${params.outdir}/abundance/mag" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // cohort_mag_catalog_<metric>_merged.tsv  →  mag.<metric>.tsv
                return filename.replaceFirst(/^cohort_mag_catalog_(\w+)_merged\.tsv$/, 'mag.$1.tsv')
            }
        ]
    }

    // dRep winners keep Binette's .fa suffix, not .fasta.
    withName: '.*:MAG:GTDBTK_CLASSIFYWF' {

        ext.extension = 'fa'

        publishDir = [
            path: { "${params.outdir}/mag/gtdbtk" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MAG:SUMMARIZE_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/catalogs/mag" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
