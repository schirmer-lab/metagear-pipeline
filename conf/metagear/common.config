params {
    //Default paramemters
    databases = "all"
    validate_params = false
    workflow = "e2e"  // Default workflow name when not specified

    // Batch processing parameters
    files_batch_size = 50
    sequences_batch_size = 50000
    viral_sequences_batch_size = 5000

    // IPHOP_PREDICT has its own (smaller) batch size because each batch's wall
    // clock is dominated by host-DB BLAST scans that scale with input size.
    // Past per-batch experience: 5000 sequences ≈ 13 h, exceeding a 24 h SLURM
    // window even with 7-way concurrency. Smaller batches → more cached
    // completions per SLURM job → fewer relaunches. Decoupling it from
    // viral_sequences_batch_size means we don't invalidate VIRSORTER2 / DRAMV
    // caches when we tune IPHOP timing.
    iphop_batch_size = 3000

    // mag: ANI threshold for dRep batching. Connected components on the
    // cohort skani triangle at this threshold define one dRep batch each;
    // per-batch winners union to the cohort representative set. 0.90 is
    // strictly looser than dRep's 0.95 secondary clustering threshold so
    // within-batch dRep gives the same cohort representatives as a single
    // all-vs-all run. Lives here (not in nextflow.config) so it shares the
    // load cycle with conf/metagear/mag.config's withName: BATCH_BINS
    // `ext.args = "... ${params.drep_batch_ani}"` — Nextflow evaluates the
    // GString at config-load time, so the param must be declared in a config
    // that's merged together with the one that uses it. The wrapper merges
    // all conf/metagear/*.config files for every workflow, so this param
    // exists even when running `virus` etc. (the BATCH_BINS withName block
    // sits idle for those workflows but its GString still gets evaluated
    // at parse time).
    drep_batch_ani = 0.90

    // files_batch_size = 5
    // sequences_batch_size = 2000

    //Fallback parameters
    contigs_dir = false
    genes_dir = false
    representative_genes = false
    representative_proteins = false
    representative_proteins_annotations = false
    representative_genes_tpm = false
    representative_genes_rpkm = false
    representative_genes_count = false
}

process {

    withName: SAMPLESHEET_CHECK {

        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: "copy",
            // Drop the per-process versions.yml — the consolidated yaml is
            // written by SUMMARY's softwareVersionsToYAML at
            //   pipeline_info/${workflow}_mqc_versions.yml
            // Without this suppression both SAMPLESHEET_CHECK and MULTIQC
            // emit versions.yml here and the saveAs prefix collides them
            // both to ${workflow}_versions.yml, so they clobber each other.
            saveAs: { filename ->
                filename.equals('versions.yml') ? null : "${params.workflow}_${filename}"
            }
        ]
    }

    withName: RENAME_FILES {

        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: CONCATENATE_READS {

        publishDir = [
            enabled: false,
        ]
    }

    withName: MULTIQC {

        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: "copy",
            // Drop versions.yml — SUMMARY's softwareVersionsToYAML is the
            // consolidated source. (Same rationale as SAMPLESHEET_CHECK above.)
            saveAs: { filename ->
                filename.equals('versions.yml') ? null : "${params.workflow}_${filename}"
            }
        ]
    }

    withName: PARSE_KNEADDATA {

        publishDir = [
            path: { "${params.outdir}/kneaddata/stats" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUMMARY_KNEADDATA {

        publishDir = [
            path: { "${params.outdir}/kneaddata/stats" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
