process {

    // ─── Per-sample BWA index of chromosome contigs (binning side) ──────────
    // Scoped to BACTERIAL_BINNING so we don't clobber the catalog-side
    // BWA_INDEX used by ABUNDANCE.
    withName: '.*:BACTERIAL_BINNING:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bwa_index/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-sample read mapping (single-sample, no cross-sample) ───────────
    // -p bwa-mem is required: COVERM_MAKE gets a BWA index (ref_is_index=true)
    // not a FASTA, and without the explicit mapper choice CoverM defaults to
    // minimap2 and tries to read the reference as a FASTA path → panics with
    // "reference does not appear to exist". Mirrors abundance.config:13.
    withName: '.*:BACTERIAL_BINNING:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BACTERIAL_BINNING:SAMTOOLS_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── MetaBAT2 ───────────────────────────────────────────────────────────
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS {

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/depth" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: METABAT2_METABAT2 {

        ext.args = "--minContig 1500 --seed 1"

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── SemiBin2 (biome-aware via ext.args2 closure) ───────────────────────
    // --environment must come after the `single_easy_bin` subcommand, so it
    // goes in ext.args2 (the module appends args2 after subcommand). meta.biome
    // is injected at the subworkflow boundary and defaults to 'global' upstream.
    withName: SEMIBIN_SINGLEEASYBIN {

        // SemiBin can legitimately produce 0 bins on low-complexity samples
        // (common in oral cohort: S-219, S-442). The vendored nf-core module's
        // output_fasta declaration is non-optional, so 0-bin runs fail with
        // MissingFileException despite SemiBin's clean exit. Discriminate the
        // legitimate 0-bin case (clean exit, no output) from real crashes:
        // - exit 0 → 'ignore' (no emit; bacterial_binning.nf's remainder:true
        //   join + Binette's nullglob bin_dirs handle the missing semibin_bins)
        // - signal-induced exit (130..145 + 104 + 175..177) → 'retry'
        //   (preserves base.config's OOM/walltime escalation behavior)
        // - anything else → 'finish' (real failure, surface it)
        errorStrategy = {
            if (task.exitStatus == 0)
                return 'ignore'
            if (task.exitStatus in ((130..145) + 104 + (175..177)))
                return 'retry'
            return 'finish'
        }

        ext.args2 = { "--environment ${meta.biome ?: 'global'}" }

        publishDir = [
            path: { "${params.outdir}/binning/semibin2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Binette refinement (MIMAG MQ+ filter inside Binette) ───────────────
    // --min_completeness 50 yields MIMAG MQ+; combined with Binette's quality
    // score (completeness − weight × contamination) this gives the passing set.
    //
    // Single publishDir to assemblies/bins/<sample>/ with renamed deliverables:
    //   assemblies/bins/<sample>/
    //     ├── <sample>_bin1.fa, <sample>_bin2.fa, ...    (MAG sequences, --prefix-ed)
    //     ├── quality_report.tsv                          (renamed from final_bins_quality_reports.tsv)
    //     └── contig_to_bin.tsv                           (renamed from final_contig_to_bin.tsv)
    //
    // We previously tried this with a dual publishDir and it silently dropped
    // files. Now that we've removed the `outdir` emit from the BINETTE module,
    // publishDir is no longer driven by the noisy whole-workdir capture — it
    // only sees the file-typed emits (bins glob, quality, contig_to_bin) plus
    // the bins_dir directory emit. saveAs's basename match + rename works.
    //
    // The bins_dir emit is still in the process — MERGE_CONTIG_CLASSIFICATION
    // consumes it directly via the process channel (not via the published
    // path), so the channel staging is unaffected by what we route to
    // publishDir.
    withName: BINETTE {

        // --prefix <sample> tells Binette to emit bins as `<sample>_binN.fa`
        // (Binette hardcodes a `_` separator between prefix and `binN`, per
        // its CLI help: e.g. `--prefix sample1` produces `sample1_bin1.fa`).
        // The default prefix is `binette`, hence the existing `binette_binN.fa`
        // naming. Using ${meta.id} makes bin filenames globally unique at
        // source, eliminating the mag rename step. Binette
        // applies the prefix consistently — the QC TSV's `name` column and
        // the contig_to_bin map's bin column both read the prefixed name.
        ext.args = { "--min_completeness 50 --prefix ${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/assemblies/bins/${meta.id}" },
            mode: 'copy',
            saveAs: { filename ->
                def name = filename.toString().tokenize('/').last()
                if (name == 'versions.yml')                       return null
                // Prefix the QC + contig→bin TSVs with the sample id so each
                // file is globally unique AND self-descriptive when shared
                // out of context. Lets cohort-level steps collect them flat
                // without filename collisions.
                if (name == 'final_bins_quality_reports.tsv')     return "${meta.id}.quality_report.tsv"
                if (name == 'final_contig_to_bin.tsv')            return "${meta.id}.contig_to_bin.tsv"
                if (name.endsWith('.fa'))                         return name
                return null
            }
        ]
    }

    // NOTE: GTDB-Tk taxonomy is intentionally NOT configured in this
    // subworkflow. Bacterial MAG taxonomy is deferred to the
    // mag iteration (dRep at 95% ANI = GTDB species threshold,
    // so running GTDB-Tk on representatives is what the literature does).
    // The GTDBTK_CLASSIFYWF module is still used by the MSP pipeline.

}
