process {

    // Scoped to BACTERIAL_BINNING so it does not clobber the catalog-side
    // BWA_INDEX that ABUNDANCE configures.
    withName: '.*:BACTERIAL_BINNING:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bwa_index/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // -p bwa-mem is required: COVERM_MAKE is given a BWA index, not a FASTA, and
    // CoverM otherwise defaults to minimap2 and panics reading it as a FASTA.
    withName: '.*:BACTERIAL_BINNING:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BACTERIAL_BINNING:SAMTOOLS_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS {

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/depth" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: METABAT2_METABAT2 {

        ext.args = "--minContig 1500 --seed 1"

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --environment must follow the single_easy_bin subcommand, which is what
    // ext.args2 does; ext.args would place it before.
    withName: SEMIBIN_SINGLEEASYBIN {

        // SemiBin exits 0 having produced no bins on low-complexity samples, and
        // the vendored module's output_fasta is not optional, so those runs fail on
        // a missing file. Ignoring exit 0 is therefore not ignoring a failure;
        // downstream joins already tolerate the absent bins.
        errorStrategy = {
            if (task.exitStatus == 0)
                return 'ignore'
            if (task.exitStatus in ((130..145) + 104 + (175..177)))
                return 'retry'
            return 'finish'
        }

        ext.args2 = { "--environment ${meta.biome ?: 'global'}" }

        publishDir = [
            path: { "${params.outdir}/binning/semibin2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --min_completeness 50 is the MIMAG medium-quality threshold. The bins_dir
    // emit is not published here because MERGE_CONTIG_CLASSIFICATION reads it
    // through the channel rather than from the published tree.
    withName: BINETTE {

        // --prefix makes bin names globally unique at source: Binette emits
        // <prefix>_binN.fa and writes the same name into the quality report's
        // name column and the contig_to_bin map.
        ext.args = { "--min_completeness 50 --prefix ${meta.id}" }

        publishDir = [
            path: { "${params.outdir}/assemblies/bins/${meta.id}" },
            mode: 'copy',
            saveAs: { filename ->
                def name = filename.toString().tokenize('/').last()
                if (name == 'versions.yml')                       return null
                // Prefixed so cohort-level steps can collect them flat.
                if (name == 'final_bins_quality_reports.tsv')     return "${meta.id}.quality_report.tsv"
                if (name == 'final_contig_to_bin.tsv')            return "${meta.id}.contig_to_bin.tsv"
                if (name.endsWith('.fa'))                         return name
                return null
            }
        ]
    }

    // GTDB-Tk is deliberately absent here: bacterial MAG taxonomy runs in the
    // mag workflow on dRep representatives, whose 95% ANI is the GTDB species
    // threshold. The module itself is still used by msp.

}
