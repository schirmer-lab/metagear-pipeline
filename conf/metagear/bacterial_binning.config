process {

    // ─── Per-sample BWA index of chromosome contigs (binning side) ──────────
    // Scoped to BACTERIAL_BINNING so we don't clobber the catalog-side
    // BWA_INDEX used by ABUNDANCE.
    withName: '.*:BACTERIAL_BINNING:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bwa_index/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-sample read mapping (single-sample, no cross-sample) ───────────
    // -p bwa-mem is required: COVERM_MAKE gets a BWA index (ref_is_index=true)
    // not a FASTA, and without the explicit mapper choice CoverM defaults to
    // minimap2 and tries to read the reference as a FASTA path → panics with
    // "reference does not appear to exist". Mirrors abundance.config:13.
    withName: '.*:BACTERIAL_BINNING:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BACTERIAL_BINNING:SAMTOOLS_INDEX' {

        publishDir = [
            path: { "${params.outdir}/binning/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── MetaBAT2 ───────────────────────────────────────────────────────────
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS {

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/depth" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: METABAT2_METABAT2 {

        ext.args = "--minContig 1500 --seed 1"

        publishDir = [
            path: { "${params.outdir}/binning/metabat2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── SemiBin2 (biome-aware via ext.args2 closure) ───────────────────────
    // --environment must come after the `single_easy_bin` subcommand, so it
    // goes in ext.args2 (the module appends args2 after subcommand). meta.biome
    // is injected at the subworkflow boundary and defaults to 'global' upstream.
    withName: SEMIBIN_SINGLEEASYBIN {

        ext.args2 = { "--environment ${meta.biome ?: 'global'}" }

        publishDir = [
            path: { "${params.outdir}/binning/semibin2/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Binette refinement (MIMAG MQ+ filter inside Binette) ───────────────
    // --min_completeness 50 yields MIMAG MQ+; combined with Binette's quality
    // score (completeness − weight × contamination) this gives the passing set.
    //
    // BINETTE emits everything inside `${prefix}/` (= `${meta.id}/`). Dual
    // publishDir splits the per-sample outputs by audience:
    //   assemblies/bins/<sample>/                      (user-facing deliverables)
    //     ├── binette_binN.fa                          (MAG sequences)
    //     ├── quality_report.tsv                       (renamed from final_bins_quality_reports.tsv)
    //     └── contig_to_bin.tsv                        (renamed from final_contig_to_bin.tsv)
    //   binning/binette/<sample>/                      (process intermediates)
    //     ├── input_bins_quality_reports/              (pre-Binette bin QC)
    //     └── temporary_files/                         (Binette internals)
    //
    // The 3-file deliverable set co-locates so `assemblies/bins/<sample>/`
    // is the single anchor for "everything about sample X's MAGs" — used
    // by metagear-tools' bins_dir reuse + cohort_dereplication INIT.
    // Pure publishDir change: BINETTE's work-dir filenames are unchanged,
    // so the process cache stays valid.
    withName: BINETTE {

        ext.args = "--min_completeness 50"

        publishDir = [
            // → assemblies/bins/<sample>/   (FASTAs + the two co-essential TSVs)
            [
                path   : { "${params.outdir}/assemblies/bins" },
                mode   : 'copy',
                saveAs : { filename ->
                    if (filename.equals('versions.yml')) return null
                    // BINETTE outputs land under "${meta.id}/<rest>". Map the
                    // deliverable subset; everything else routes via the second
                    // publishDir below.
                    if (filename.endsWith('/final_bins_quality_reports.tsv'))
                        return filename.replaceFirst(/\/final_bins_quality_reports\.tsv$/, '/quality_report.tsv')
                    if (filename.endsWith('/final_contig_to_bin.tsv'))
                        return filename.replaceFirst(/\/final_contig_to_bin\.tsv$/, '/contig_to_bin.tsv')
                    // MAG FASTAs live under "${meta.id}/final_bins/*.fa" — strip
                    // the "final_bins/" so they sit directly under <sample>/.
                    if (filename ==~ /^[^\/]+\/final_bins\/.+\.fa$/)
                        return filename.replaceFirst(/\/final_bins\//, '/')
                    return null
                }
            ],
            // → binning/binette/<sample>/   (process intermediates only)
            [
                path   : { "${params.outdir}/binning/binette" },
                mode   : 'copy',
                saveAs : { filename ->
                    if (filename.equals('versions.yml')) return null
                    // Skip the deliverables (handled by the first publishDir).
                    if (filename.endsWith('/final_bins_quality_reports.tsv')) return null
                    if (filename.endsWith('/final_contig_to_bin.tsv'))        return null
                    if (filename ==~ /^[^\/]+\/final_bins\/.+\.fa$/)          return null
                    return filename
                }
            ]
        ]
    }

    // NOTE: GTDB-Tk taxonomy is intentionally NOT configured in this
    // subworkflow. Bacterial MAG taxonomy is deferred to the
    // cohort_dereplication iteration (dRep at 95% ANI = GTDB species threshold,
    // so running GTDB-Tk on representatives is what the literature does).
    // The GTDBTK_CLASSIFYWF module is still used by the MSP pipeline.

}
