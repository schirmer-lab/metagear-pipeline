process {

    // MEGAHIT emits two files per sample: the assembled contigs and the
    // de Bruijn graph. Split via dual publishDir so the assemblies/ tree is
    // organized by content type, not by tool:
    //   assemblies/contigs/<sample>.contigs.fa.gz
    //   assemblies/assembly_graphs/<sample>.k119.fastg.gz
    // The graph is intentionally kept (no downstream consumer in this
    // pipeline today, but third-party tools — vRhyme, BinSPreader,
    // assembly-graph viral callers — can use it).
    withName: MEGAHIT {

        publishDir = [
            [
                path   : { "${params.outdir}/assemblies/contigs" },
                mode   : 'copy',
                saveAs : { fn -> fn.endsWith('.contigs.fa.gz') ? fn : null }
            ],
            [
                path   : { "${params.outdir}/assemblies/assembly_graphs" },
                mode   : 'copy',
                saveAs : { fn -> fn.endsWith('.fastg.gz') ? fn : null }
            ]
        ]
    }

}
