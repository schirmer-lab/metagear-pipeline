process {

    // The assembly graph has no consumer in this pipeline; it is kept because
    // third-party tools (vRhyme, BinSPreader, graph-based viral callers) use it.
    withName: MEGAHIT {

        publishDir = [
            [
                path   : { "${params.outdir}/assemblies/contigs" },
                mode   : 'copy',
                saveAs : { fn -> fn.endsWith('.contigs.fa.gz') ? fn : null }
            ],
            [
                path   : { "${params.outdir}/assemblies/assembly_graphs" },
                mode   : 'copy',
                saveAs : { fn -> fn.endsWith('.fastg.gz') ? fn : null }
            ]
        ]
    }

}
