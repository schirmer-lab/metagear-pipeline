process {

    withName: KNEADDATA_DATABASE {

        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: METAPHLAN_MAKEDB {

        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: HUMANN_DATABASES {

        ext.args = "--update-config no"

        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: GENOMAD_DOWNLOAD {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: PHABOX2_DOWNLOAD {

        // The bundle URL is version-bound and lives in the module's ext.url, so a
        // future release can be pointed at from config without touching the module.
        // phabox2 has no download subcommand to ask for it.

        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: CHECKV_DOWNLOADDATABASE {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: VIRSORTER2_SETUP {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: DRAM_SETUP {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: IPHOP_DOWNLOAD {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: AMRFINDERPLUS_UPDATE {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: MMSEQS_DATABASES {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

    withName: PHOLD_INSTALL {


        publishDir = [
            path: { "${params.outdir}" },
            saveAs: { filename -> null }
        ]
    }

}
