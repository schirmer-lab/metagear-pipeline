/*
 * MSP — MetaSpecies Pangenomes workflow.
 *
 * MSPminer co-abundance clustering on the gene catalog, GTDB-Tk taxonomy on
 * MSP representative sequences, and MetaPhlAn cross-walk. Builds on a prior
 * `genes` run; reads the gene catalog and per-sample abundance matrices from
 * disk.
 *
 * All process artefacts publish under msp/ to sit as a sibling to mag/ —
 * both are cohort-level species catalogs (gene-centric vs genome-centric).
 *
 * NOTE: This file is merged in by the external metagear-tools wrapper at
 * invocation time — when running `nextflow run .` directly it is not active.
 */
params {
    metaphlan_profiles = false
}

process {

    withName: MSPMINER_MSPMINER {

        publishDir = [
            path: { "${params.outdir}/msp/mspminer" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    withName: MSP_SEQUENCES {

        publishDir = [
            path: { "${params.outdir}/msp" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    withName: MSP_ABUNDANCE {

        publishDir = [
            path: { "${params.outdir}/abundance/msp" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    // GTDB-Tk classify_wf runs against MSP_SEQUENCES.out.pangenome_dir; the
    // outputs are routed under msp/gtdbtk/ to mirror mag/gtdbtk/ (process
    // artefacts published at the top level alongside the catalog).
    withName: '.*:MSP:GTDBTK_CLASSIFYWF' {

        publishDir = [
            path: { "${params.outdir}/msp/gtdbtk" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    withName: MSP_METAPHLAN_ANNOTATION {

        publishDir = [
            path: { "${params.outdir}/msp" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }
}
