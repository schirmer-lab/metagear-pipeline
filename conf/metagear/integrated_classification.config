// Workflow-level config for the `integrated_classification` entry workflow.
//
// Per-process overrides for the included subworkflows live in:
//   - conf/metagear/viral_detection.config   — GENOMAD_PASS{1,2}, CHECKV_PASS{1,2},
//                                              GENOMAD_EXTRACT_CHROMOSOME,
//                                              MERGE_TABLES, EXTRACT_SEQUENCES
//   - conf/metagear/bacterial_binning.config — BWA_INDEX (BACTERIAL_BINNING-
//                                              scoped), COVERM_MAKE,
//                                              SAMTOOLS_INDEX, METABAT2_*,
//                                              SEMIBIN_SINGLEEASYBIN, BINETTE
//
// Overrides specific to integrated_classification (Tiara, the unbinned
// extraction, MMseqs2 fallback taxonomy, the per-contig TSV merge) go here.

process {

    // ─── Tiara (eukaryote screen, label-only in v1) ──────────────────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:TIARA_TIARA' {

        publishDir = [
            path: { "${params.outdir}/classification/tiara" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Extract post-Binette unbinned chromosome contigs ────────────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:EXTRACT_UNBINNED' {

        publishDir = [
            path: { "${params.outdir}/classification/unbinned" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── MMseqs2 easy-taxonomy contig fallback (opt-in via --enable_contig_taxonomy) ──
    // Only runs when the user sets --enable_contig_taxonomy true. The default
    // pipeline skips it because per-contig LCA on unbinned contigs is
    // low-confidence (sub-domain precision is discarded by the merge anyway,
    // which only consumes the first lineage rank) and slow against the
    // ~200 GiB GTDB DB.
    //
    // Args are tuned for SPEED — domain-level signal is robust to all of
    // these relaxations:
    //   --tax-lineage 1        keep the lineage column (parsed into the per-
    //                          contig TSV's `lineage` field).
    //   --orf-filter 1         re-enable the default ORF-level prefilter;
    //                          skips no-hit ORFs early instead of running
    //                          full alignment on them.
    //   --lca-mode 1           disable the 2bLCA secondary search. Default
    //                          mode 3 doubles the work for sub-domain
    //                          precision we don't use.
    //   -s 2.0                 "very fast" sensitivity (wiki scale 1.0-7.0).
    //                          Domain-level hits land easily here; sub-domain
    //                          precision we don't use anyway.
    //   --max-accept 30        cap hits per query at 30 (default: unbounded).
    //   --split-memory-limit   dynamic: 70% of task.memory. mmseqs reads
    //                          0.85*available_memory off /proc; the 70% floor
    //                          leaves headroom for OS + temp files.
    //   --remove-tmp-files 1   delete intermediate files after each pass —
    //                          easy-taxonomy's tmp/ can be many GiB.
    //
    // MEMORY FLOOR: task.memory MUST be at least ~96 GiB for the prefilter to
    // fit a chunk of the GTDB DB (recent builds are ~200 GiB in mmseqs2
    // format, was ~30 GiB historically — has grown ~6×). mmseqs2 has ~14 GiB
    // of fixed overhead on top of --split-memory-limit, and the residual must
    // hold the chunk's k-mer index. The speed-tuned args do NOT reduce the
    // memory floor — that's a function of target-DB chunk size, not query
    // parameters.
    //
    // No maxForks override: Nextflow already schedules tasks against the
    // host's total cpu/memory budget via process.resourceLimits, so it will
    // only ever run as many parallel MMSEQS_EASYTAXONOMY tasks as
    // (host_memory / task.memory) allows.
    withName: '.*:INTEGRATED_CLASSIFICATION:MMSEQS_EASYTAXONOMY' {

        ext.args = { def mem_g = task.memory ? Math.max(8, (task.memory.toGiga() * 0.7).intValue()) : 16
                     "--tax-lineage 1 --orf-filter 1 --lca-mode 1 -s 2.0 --max-accept 30 " +
                     "--split-memory-limit ${mem_g}G --remove-tmp-files 1" }

        publishDir = [
            path: { "${params.outdir}/classification/contig_taxonomy/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-contig classification TSV (the iter-3 deliverable) ──────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:MERGE_CONTIG_CLASSIFICATION' {

        publishDir = [
            path: { "${params.outdir}/classification/per_contig" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-gene-cluster classification (cohort-level, opt-in via --gene_clusters_tsv) ──
    // CLASSIFY_GENES emits a per-representative TSV that annotates each cluster
    // rep with the set of per-contig classes seen across its members. Lands at
    // classification/all.genes.clusters.classified.refined.tsv, parallel to
    // viral_analysis's `.draft` and `.raw` siblings (which are also rerouted
    // to classification/ via publishDir saveAs in viral_analysis.config).
    withName: '.*:INTEGRATED_CLASSIFICATION:CLASSIFY_GENES' {

        publishDir = [
            path: { "${params.outdir}/classification" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename == 'versions.yml')                          return null
                if (filename == 'all.genes.clusters.classified.tsv')     return 'all.genes.clusters.classified.refined.tsv'
                return filename
            }
        ]
    }

}
