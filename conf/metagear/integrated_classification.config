// Workflow-level config for the `integrated_classification` entry workflow.
//
// Per-process overrides for the included subworkflows live in:
//   - conf/metagear/viral_detection.config   — GENOMAD_PASS{1,2}, CHECKV_PASS{1,2},
//                                              GENOMAD_EXTRACT_CHROMOSOME,
//                                              MERGE_TABLES, EXTRACT_SEQUENCES
//   - conf/metagear/bacterial_binning.config — BWA_INDEX (BACTERIAL_BINNING-
//                                              scoped), COVERM_MAKE,
//                                              SAMTOOLS_INDEX, METABAT2_*,
//                                              SEMIBIN_SINGLEEASYBIN, BINETTE
//
// Overrides specific to integrated_classification (Tiara, the unbinned
// extraction, MMseqs2 fallback taxonomy, the per-contig TSV merge) go here.

process {

    // ─── Tiara (eukaryote screen, label-only in v1) ──────────────────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:TIARA_TIARA' {

        publishDir = [
            path: { "${params.outdir}/integrated_classification/tiara" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Extract post-Binette unbinned chromosome contigs ────────────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:EXTRACT_UNBINNED' {

        publishDir = [
            path: { "${params.outdir}/integrated_classification/unbinned" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── MMseqs2 easy-taxonomy contig fallback ───────────────────────────────
    // Defaults:
    //   --tax-lineage 1        request the lineage column in the LCA output
    //                          (parsed into the per-contig TSV's `lineage` field)
    //   --orf-filter 0         classify every contig regardless of ORF count
    //                          (want full coverage in the TSV)
    //   --split-memory-limit   dynamic: 70% of task.memory. mmseqs itself
    //                          reads 0.85*available_memory off /proc; the 70%
    //                          floor leaves headroom for the OS + temp files.
    //                          The GTDB taxonomy DB is ~30 GB and mmseqs
    //                          chunks the search under this limit.
    //   --remove-tmp-files 1   delete intermediate files after each pass —
    //                          easy-taxonomy's tmp/ can be many GiB and
    //                          accumulates if left behind.
    //
    // MEMORY FLOOR: task.memory MUST be at least ~24 GiB for the prefilter to
    // fit the GTDB DB. If your ~/.metagear/metagear.config caps `max_memory`
    // below ~32 GiB, mmseqs2 dies with "Cannot fit databases into <X>G" no
    // matter what we set here — bump max_memory first. The module also runs
    // a pre-flight check on /proc/meminfo and fails fast with a clear error
    // before invoking mmseqs.
    //
    // No maxForks override: Nextflow already schedules tasks against the
    // host's total cpu/memory budget via process.resourceLimits, so it will
    // only ever run as many parallel MMSEQS_EASYTAXONOMY tasks as
    // (host_memory / task.memory) allows. Artificially serialising with
    // maxForks=1 would just leave compute idle on a roomy server.
    withName: '.*:INTEGRATED_CLASSIFICATION:MMSEQS_EASYTAXONOMY' {

        ext.args = { def mem_g = task.memory ? Math.max(8, (task.memory.toGiga() * 0.7).intValue()) : 16
                     "--tax-lineage 1 --orf-filter 0 --split-memory-limit ${mem_g}G --remove-tmp-files 1" }

        publishDir = [
            path: { "${params.outdir}/integrated_classification/contig_taxonomy/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Per-contig classification TSV (the iter-3 deliverable) ──────────────
    withName: '.*:INTEGRATED_CLASSIFICATION:MERGE_CONTIG_CLASSIFICATION' {

        publishDir = [
            path: { "${params.outdir}/integrated_classification/per_contig" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
