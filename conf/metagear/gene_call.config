process {

    withName: MEGAHIT {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
    }

    withName: PRODIGAL {
        ext.args = "-p meta"

        publishDir = [
            path: { "${params.outdir}/prodigal/raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
    }

    withName: FILTER_PRODIGAL {

        publishDir = [
            path: { "${params.outdir}/prodigal" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
    }

    withName: '.*:CLUSTER_GENES:VAMB_CONCATENATE_FASTA' {

        ext.args = "-m 10 --keepnames"
        ext.args2 = "--catalog_name catalog"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/catalogs/raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:CLUSTER_GENES:MMSEQS_EASY_CLUSTER' {
        ext.args = "--min-seq-id 0.95 --cov-mode 0 -c 0.90 --alignment-mode 3"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
