process {

    withName: PRODIGAL {
        ext.args = "-p meta"

        publishDir = [
            path: { "${params.outdir}/prodigal/raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    withName: FILTER_PRODIGAL {

        publishDir = [
            path: { "${params.outdir}/prodigal" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }

    withName: '.*:VAMB_CONCATENATE_FASTA' {

        ext.args = "-m 10 --keepnames"
        //ext.args2 = "--catalog_name catalog"


        publishDir = [
            path: { "${params.outdir}/catalogs/raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:CLUSTER_GENES:MMSEQS_EASY_CLUSTER' {
        ext.args = "--min-seq-id 0.95 --cov-mode 0 -c 0.90 --alignment-mode 3"


        // Cohort gene catalog lives under catalogs/genes/ alongside the
        // virus.genes.* and plasmid.genes.* class-scoped catalogs.
        publishDir = [
            path: { "${params.outdir}/catalogs/genes" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_GENES' {

        // Per-sample subdir layout (parallel to virus/per_sample/<sample>/).
        // EXTRACT_GENES is invoked from VIRAL_GENE_CALL with meta.id
        // = `<sample>.<class>.genes` and meta.src = `<sample>`. The class
        // is preserved in the filename (virus.genes.* vs plasmid.genes.*)
        // because the same dir holds both, and ".genes." disambiguates the
        // gene IDs from contig IDs sitting in virus/per_sample/<sample>/.
        publishDir = [
            path: { "${params.outdir}/virus/genes/${meta.src}" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Strip the redundant sample prefix; the subdir already carries it.
                return filename.replaceFirst(/^${meta.src}\./, '')
            }
        ]
    }

}
