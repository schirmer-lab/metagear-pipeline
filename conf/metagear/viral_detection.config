process {

    withName: GENOMAD_PASS1 {

        ext.args = "--cleanup --conservative --enable-score-calibration"


        publishDir = [
            path: { "${params.outdir}/virus/genomad/virus/${task.tag}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHECKV_PASS1 {

        ext.args = "--remove_tmp"


        publishDir = [
            path: { "${params.outdir}/virus/checkv/virus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return virus.<orig>”
            saveAs: { filename ->
                def baseName = (filename instanceof String) ? filename.tokenize('/')[-1] : filename.name
                return filename.equals('versions.yml') ? null : "virus.${baseName}"
            }
        ]

    }

    withName: GENOMAD_PASS2 {

        ext.args = "--cleanup --conservative --enable-score-calibration"


        publishDir = [
            path: { "${params.outdir}/virus/genomad/provirus/${task.tag}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHECKV_PASS2 {

        ext.args = "--remove_tmp"


        publishDir = [
            path: { "${params.outdir}/virus/checkv/provirus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return “provirus.<orig>”
            saveAs: { filename ->
                def baseName = (filename instanceof String) ? filename.tokenize('/')[-1] : filename.name
                return filename.equals('versions.yml') ? null : "provirus.${baseName}"
            }
        ]
    }

    withName: GENOMAD_EXTRACT_CHROMOSOME {

        publishDir = [
            path: { "${params.outdir}/virus/genomad/chromosome" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-sample viral detection intermediates land under
    //   virus/per_sample/<sample>/
    // with normalized filenames (no sample prefix, dot-separated, lowercase,
    // explicit .fna for the gzipped FASTAs). The dir name describes the
    // contents (per-sample files) instead of the operation (merge + filter
    // of geNomad/CheckV tables). Brings this in line with the rest of the
    // per-sample binning/detection subdirs (genomad/<sample>,
    // checkv/<sample>, metabat2/<sample>, semibin2/<sample>, binette/<sample>).
    // Pure publish-time rename — module scripts and work-dir filenames are
    // unchanged, so MERGE_TABLES + EXTRACT_SEQUENCES caches are valid.
    withName: MERGE_TABLES {


        publishDir = [
            path: { "${params.outdir}/virus/per_sample/${meta.id}" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Strip the sample-id prefix (the subdir already carries it).
                def stripped = filename.replaceFirst(/^${meta.id}[._]/, '')
                // Normalize the verbose / PascalCase / snake_case names:
                //   Merged_Genomad_CheckV_Summary[.filtered].tsv → virus.summary[.filtered].tsv
                //   Plasmid_Summary[.filtered].tsv               → plasmid.summary[.filtered].tsv
                //   viral_ids_to_keep.txt                         → virus.ids.txt
                //   plasmid_ids_to_keep.txt                       → plasmid.ids.txt
                return stripped
                    .replaceFirst(/^Merged_Genomad_CheckV_Summary/, 'virus.summary')
                    .replaceFirst(/^Plasmid_Summary/,               'plasmid.summary')
                    .replaceFirst(/^viral_ids_to_keep\.txt$/,       'virus.ids.txt')
                    .replaceFirst(/^plasmid_ids_to_keep\.txt$/,     'plasmid.ids.txt')
            }
        ]
    }

    withName: EXTRACT_SEQUENCES {

        ext.args2 = "--catalog_name filtered"

        publishDir = [
            path: { "${params.outdir}/virus/per_sample/${meta.id}" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Strip the sample-id prefix and label the gzipped FASTAs as .fna.gz
                // (gunzip then yields *.fna so users see immediately it's nucleotide).
                //   SAMPLE-0.virus.filtered.gz   → virus.filtered.fna.gz
                //   SAMPLE-0.plasmid.filtered.gz → plasmid.filtered.fna.gz
                def stripped = filename.replaceFirst(/^${meta.id}\./, '')
                if (stripped.endsWith('.filtered.gz'))
                    stripped = stripped.replaceFirst(/\.filtered\.gz$/, '.filtered.fna.gz')
                return stripped
            }
        ]
    }


}
