process {

    withName: GENOMAD_PASS1 {

        ext.args = "--cleanup --conservative --enable-score-calibration"


        publishDir = [
            path: { "${params.outdir}/virus/genomad/virus/${task.tag}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHECKV_PASS1 {

        ext.args = "--remove_tmp"


        publishDir = [
            path: { "${params.outdir}/virus/checkv/virus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return virus.<orig>”
            saveAs: { filename ->
                def baseName = (filename instanceof String) ? filename.tokenize('/')[-1] : filename.name
                return filename.equals('versions.yml') ? null : "virus.${baseName}"
            }
        ]

    }

    withName: GENOMAD_PASS2 {

        ext.args = "--cleanup --conservative --enable-score-calibration"


        publishDir = [
            path: { "${params.outdir}/virus/genomad/provirus/${task.tag}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CHECKV_PASS2 {

        ext.args = "--remove_tmp"


        publishDir = [
            path: { "${params.outdir}/virus/checkv/provirus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return “provirus.<orig>”
            saveAs: { filename ->
                def baseName = (filename instanceof String) ? filename.tokenize('/')[-1] : filename.name
                return filename.equals('versions.yml') ? null : "provirus.${baseName}"
            }
        ]
    }

    withName: GENOMAD_EXTRACT_CHROMOSOME {

        publishDir = [
            path: { "${params.outdir}/virus/genomad/chromosome" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The rename happens at publish time only, so MERGE_TABLES and
    // EXTRACT_SEQUENCES caches stay valid.
    withName: MERGE_TABLES {


        publishDir = [
            path: { "${params.outdir}/virus/per_sample/${meta.id}" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Strip the sample-id prefix (the subdir already carries it).
                def stripped = filename.replaceFirst(/^${meta.id}[._]/, '')
                return stripped
                    .replaceFirst(/^Merged_Genomad_CheckV_Summary/, 'virus.summary')
                    .replaceFirst(/^Plasmid_Summary/,               'plasmid.summary')
                    .replaceFirst(/^viral_ids_to_keep\.txt$/,       'virus.ids.txt')
                    .replaceFirst(/^plasmid_ids_to_keep\.txt$/,     'plasmid.ids.txt')
            }
        ]
    }

    withName: EXTRACT_SEQUENCES {

        ext.args2 = "--catalog_name filtered"

        publishDir = [
            path: { "${params.outdir}/virus/per_sample/${meta.id}" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // The .fna suffix is added so gunzip yields a file whose name says it
                // holds nucleotides.
                def stripped = filename.replaceFirst(/^${meta.id}\./, '')
                if (stripped.endsWith('.filtered.gz'))
                    stripped = stripped.replaceFirst(/\.filtered\.gz$/, '.filtered.fna.gz')
                return stripped
            }
        ]
    }


}
