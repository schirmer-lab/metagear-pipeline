process {

    withName: GENOMAD_PASS1 {

        ext.args = "--cleanup --conservative --enable-score-calibration"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/genomad/virus/${task.tag}" },
            mode: 'copy'
        ]
    }

    withName: CHECKV_PASS1 {

        ext.args = "--remove_tmp"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/checkv/virus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return virus.<orig>”
            saveAs: { file ->
                def baseName = (file instanceof String) ? file.tokenize( '/' )[-1] : file.name
                return "virus.${baseName}"
            }
        ]

    }

    withName: GENOMAD_PASS2 {

        ext.args = "--cleanup --conservative --enable-score-calibration"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/genomad/provirus/${task.tag}" },
            mode: 'copy'
        ]
    }

    withName: CHECKV_PASS2 {

        ext.args = "--remove_tmp"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/checkv/provirus/${task.tag}" },
            mode: 'copy',

            // for each file, strip its original name and return “provirus.<orig>”
            saveAs: { file ->
                def baseName = (file instanceof String) ? file.tokenize( '/' )[-1] : file.name
                return "provirus.${baseName}"
            }
        ]
    }

    withName: MERGE_VIRUS_TABLES {

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/merge_filter" },
            mode: "copy"
        ]
    }

    withName: SEQTK_SUBSEQ {

        ext.args2 = "--catalog_name filtered_virus"
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/mge/merge_filter" },
            mode: "copy"
        ]
    }

    withName: SUMMARIZE_DETECTION {

        publishDir = [
            path: { "${params.outdir}/mge" },
            mode: "copy"
        ]
    }

}