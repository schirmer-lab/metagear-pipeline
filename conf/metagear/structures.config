/*
 * Structures — protein structural-homology annotation.
 *
 * Default backend is PHOLD (ProstT5 → 3Di → Foldseek vs the PHOLD curated
 * DB). The workflow consumes a prior virus/genes run's protein catalog
 * (auto-reuse from `catalogs/proteins/`) and emits two annotation tables:
 *
 *   annotations/phold/all.proteins.phold.tsv     — per all-protein-rep
 *   annotations/phold/virus.proteins.phold.tsv   — per viral-protein-rep
 *
 * Viral coverage is guaranteed in every scope mode via a top-up step in
 * FILTER_STRUCTURES_INPUTS; the viral output table includes a `relation`
 * column distinguishing direct PHOLD hits from cluster-propagated ones.
 *
 * NOTE: This file is merged in by the external metagear-tools wrapper at
 * invocation time — when running `nextflow run .` directly it is not active.
 */
params {

    // ─── Workflow-level toggles ──────────────────────────────────────────────

    // Backend selection — only 'phold' supported in v1. Future backends:
    // 'foldseek_afdb' (Foldseek vs AlphaFoldDB), 'esmfold_then_foldseek'
    // (real-structure prediction). The backend's path is set via
    // params.phold_db (see install/metagear.config).
    structures_backend = 'phold'

    // Which proteins to annotate. Single-param design — viral coverage is
    // guaranteed in every mode (the viral top-up in FILTER_STRUCTURES_INPUTS
    // adds viral-gene-rep translations not already in the selected subset).
    //
    //   'all'                    — every all-protein-rep
    //   'unannotated'            — reps with no Pfam hit
    //   'unannotated_plus_duf'   — adds DUF-only / weak-Pfam reps. Default —
    //                              best ROI on annotation gain per compute spent.
    //   'viral_only'             — viral-gene-rep translations only.
    structures_scope = 'unannotated_plus_duf'

    // CPU vs GPU for the ProstT5 prediction step. Default 'true' (CPU) so the
    // workflow runs on any node; flip to 'false' on a GPU-enabled compute
    // node for a 10–50× speedup on PHOLD_PREDICT.
    structures_use_cpu = true

    // ProstT5 batch size for PHOLD_PREDICT. Higher = faster on GPU + higher
    // VRAM. 1 is the PHOLD default and is fine for CPU.
    structures_batch_size = 1

    // Approx. number of input shards for parallel PHOLD_PREDICT. The actual
    // shard count is gated by SEQKIT_SPLIT2 chunk size (`-s` in ext.args
    // below), not by this param directly — kept here so users can tune
    // both in one place.
    structures_predict_shard_size = 500

    // Offsite-GPU mode. When `true`, the workflow runs FILTER_STRUCTURES_INPUTS
    // + SEQKIT_SPLIT2 + PACKAGE_PHOLD_OFFSITE and stops — producing a
    // self-contained rsync-friendly bundle under
    // ${outdir}/structures/offsite_predict/. The user runs the bundled
    // script on a GPU server (no Nextflow / no containers needed), rsyncs
    // the results back into ${outdir}/structures/phold_predict/, and
    // re-invokes `metagear structures` with the same args minus this flag
    // — auto-reuse picks up the rsynced predictions and resumes from
    // MERGE_PHOLD_PREDICTIONS onward.
    structures_prepare_for_gpu = false

    // Path to pre-existing per-shard PHOLD_PREDICT outputs. When set, skips
    // the predict step entirely and consumes the on-disk dirs. Normally
    // auto-injected by --reuse-outputs when ${outdir}/structures/phold_predict/
    // exists; the explicit param exists so users can point at a directory
    // elsewhere (e.g. a shared scratch path).
    phold_predict_dir = null
}

process {

    // ─── 1. Filter the input subset + build the viral join table ─────────────
    // Filter is internal staging — no publishing. Threads the scope param
    // into the python helper's CLI.
    withName: '.*:STRUCTURES:FILTER_STRUCTURES_INPUTS' {
        ext.args = "--scope ${params.structures_scope}"
        publishDir = [ enabled: false ]
    }

    // ─── 2. Sharding via SEQKIT_SPLIT2 ───────────────────────────────────────
    // We alias the module as SEQKIT_SPLIT2_STRUCTURES in the subworkflow so
    // this withName: scoping doesn't collide with iPHoP / InterProScan use.
    withName: '.*:STRUCTURES:SEQKIT_SPLIT2_STRUCTURES' {
        ext.args = "-s ${params.structures_predict_shard_size} -e '.gz'"
        publishDir = [ enabled: false ]
    }

    // ─── 3. PHOLD_PREDICT (ProstT5) ──────────────────────────────────────────
    // Per-shard predictions are published under structures/phold_predict/ so
    // they persist across runs. This serves two purposes:
    //
    //   1. Resume after an offsite-GPU run: rsync the predict dirs back
    //      to this path and a follow-up `metagear structures` invocation
    //      (without --structures_prepare_for_gpu) auto-picks them up via
    //      `--reuse-outputs` → `--phold_predict_dir`.
    //
    //   2. Re-running with a different scope on the same outdir is cached
    //      cleanly — the per-shard predictions don't have to be recomputed
    //      if their input shard is unchanged.
    //
    // Per-shard output size is modest (~150 KB per shard at viral_only
    // scope, scales with shard count).
    withName: '.*:STRUCTURES:PHOLD_PREDICT' {

        // CPU/GPU + batch-size threading. `--cpu` is a PHOLD flag; we add
        // it conditionally so the same withName block serves both modes.
        ext.args = ( params.structures_use_cpu ? "--cpu " : "" ) + "--batch_size ${params.structures_batch_size}"

        publishDir = [
            path: { "${params.outdir}/structures/phold_predict" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // PHOLD_PREDICT emits predict_<shard_id>/... directly — keep
                // the dir-prefixed name verbatim so resume can re-discover
                // shards via a `predict_*` glob.
                return filename
            }
        ]
    }

    // ─── 3b. PACKAGE_PHOLD_OFFSITE (only when --structures_prepare_for_gpu) ──
    // Bundles per-shard FASTAs + viral_join_table + templated README and
    // runner script into one rsync-friendly directory under
    // structures/offsite_predict/. Pipeline stops cleanly here in offsite
    // mode; the user runs the bundled script elsewhere and rsyncs results
    // back into structures/phold_predict/ for the resume invocation.
    withName: '.*:STRUCTURES:PACKAGE_PHOLD_OFFSITE' {

        ext.structures_scope = params.structures_scope

        publishDir = [
            path: { "${params.outdir}/structures" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── 4. Merge per-shard 3Di + AA FASTAs ──────────────────────────────────
    withName: '.*:STRUCTURES:MERGE_PHOLD_PREDICTIONS' {
        publishDir = [ enabled: false ]
    }

    // ─── 5. PHOLD_COMPARE (Foldseek vs PHOLD DB) ─────────────────────────────
    // Cohort-level final step. Publishes:
    //   annotations/phold/all.proteins.phold.tsv   ← per-CDS predictions
    //   annotations/phold/all.proteins.3di.fasta   ← 3Di for downstream reuse
    withName: '.*:STRUCTURES:PHOLD_COMPARE' {

        publishDir = [
            // → annotations/phold/   (per-CDS table + 3Di FASTA)
            [
                path  : { "${params.outdir}/annotations/phold" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.endsWith('/phold_per_cds_predictions.tsv'))
                        return 'all.proteins.phold.tsv'
                    if (filename.endsWith('/phold_3di.fasta'))
                        return 'all.proteins.3di.fasta'
                    // The full compare/ dir contents (Foldseek raw hits,
                    // intermediate files) stay in the work dir — they're
                    // recoverable from the per_cds TSV and not worth the
                    // disk on a 500-sample run.
                    return null
                }
            ]
        ]
    }

    // ─── 6. Merge into the viral catalog table ───────────────────────────────
    withName: '.*:STRUCTURES:MERGE_VIRAL_PHOLD' {

        publishDir = [
            path  : { "${params.outdir}/annotations/phold" },
            mode  : 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
