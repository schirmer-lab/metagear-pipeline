// This file is merged in by the metagear-tools wrapper at invocation time, so
// `nextflow run .` alone does not apply it.
//
// None of these parameters are in nextflow_schema.json, so the accepted values
// below are their only documentation.
params {

    // Only 'phold' is implemented.
    structures_backend = 'phold'

    // Which proteins to annotate: 'all', 'unannotated', 'unannotated_plus_duf'
    // or 'viral_only'. Viral reps are topped up in every mode, so 'viral_only'
    // narrows the rest rather than being the only way to cover viruses.
    structures_scope = 'unannotated_plus_duf'

    // CPU by default so the workflow runs on any node. A GPU node is far faster
    // on PHOLD_PREDICT.
    structures_use_cpu = true

    // ProstT5 batch size. 1 is PHOLD's default and is right for CPU.
    structures_batch_size = 1

    // Proteins per PHOLD_PREDICT shard. Larger shards amortise ProstT5's
    // model-load cost, which dominates inference at small shard sizes.
    structures_predict_shard_size = 5000

    // Proteins per PHOLD_COMPARE chunk. Each invocation reloads the Foldseek
    // database, so chunks want to be large; the limit is how many can run at
    // once and how much work a failed chunk costs on resume.
    structures_compare_shard_size = 100000

    // Stop after packaging a self-contained bundle for a GPU host. Predictions
    // rsynced back into structures/phold_predict/ are picked up on the next
    // invocation without this flag.
    structures_prepare_for_gpu = false

    // Point the predict step at existing per-shard outputs instead of running
    // it. --reuse-outputs sets this automatically when they are in the outdir.
    phold_predict_dir = null
}

process {

    withName: '.*:STRUCTURES:FILTER_STRUCTURES_INPUTS' {
        ext.args = "--scope ${params.structures_scope}"
        publishDir = [ enabled: false ]
    }

    // Aliased in the subworkflow so this selector does not also match the
    // iPHoP and InterProScan uses of SEQKIT_SPLIT2.
    withName: '.*:STRUCTURES:SEQKIT_SPLIT2_STRUCTURES' {
        ext.args = "-s ${params.structures_predict_shard_size} -e '.gz'"
        publishDir = [ enabled: false ]
    }

    // Per-shard predictions are published, not left in work, so an offsite GPU
    // run can be rsynced back into them and so changing the scope does not
    // recompute shards whose input is unchanged.
    withName: '.*:STRUCTURES:PHOLD_PREDICT' {

        ext.args = ( params.structures_use_cpu ? "--cpu " : "" ) + "--batch_size ${params.structures_batch_size}"

        publishDir = [
            path: { "${params.outdir}/structures/phold_predict" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Keep the predict_<shard> prefix: resume rediscovers shards by glob.
                return filename
            }
        ]
    }

    withName: '.*:STRUCTURES:PACKAGE_PHOLD_OFFSITE' {

        ext.structures_scope = params.structures_scope

        publishDir = [
            path: { "${params.outdir}/structures" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:STRUCTURES:MERGE_PHOLD_PREDICTIONS' {

        publishDir = [
            path  : { "${params.outdir}/annotations/phold" },
            mode  : 'copy',
            pattern: 'merged_predict_dir/phold_3di.fasta',
            saveAs: { _filename -> 'all.proteins.3di.fasta' }
        ]
    }

    withName: '.*:STRUCTURES:SEQKIT_SPLIT2_COMPARE' {
        ext.args = "-s ${params.structures_compare_shard_size} -e '.gz'"
        publishDir = [ enabled: false ]
    }

    // Narrows the cohort prediction dir to each chunk's protein ids so a
    // PHOLD_COMPARE task has a self-contained input.
    withName: '.*:STRUCTURES:SPLIT_3DI_BY_AA' {
        publishDir = [ enabled: false ]
    }

    // 12 h base, not 6: at 6 h five of six chunks on a human gut cohort were
    // killed by SIGTERM at exactly the limit, before a retry could escalate.
    // Runtime per chunk depends on hit density against the PHOLD database.
    withName: '.*:STRUCTURES:PHOLD_COMPARE' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }

        publishDir = [ enabled: false ]
    }

    withName: '.*:STRUCTURES:MERGE_PHOLD_COMPARE' {

        publishDir = [
            path  : { "${params.outdir}/annotations/phold" },
            mode  : 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('/phold_per_cds_predictions.tsv'))
                    return 'all.proteins.phold.tsv'
                return null
            }
        ]
    }

    withName: '.*:STRUCTURES:MERGE_VIRAL_PHOLD' {

        publishDir = [
            path  : { "${params.outdir}/annotations/phold" },
            mode  : 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
