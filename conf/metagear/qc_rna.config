// Quality control for metatranscriptomic RNA: same steps as qc_dna, against a host
// genome plus transcriptome and rRNA references set in qc_rna_refdb.
// Must declare the same keys as qc_dna.config — see docs/workflows/qc_rna.md.

params {

    qc_max_plot_samples = 100  // beyond this the report drops the bar plot for the table

}

process {

    withName: TRIMGALORE {
        ext.args = '--phred33 --quality 0 --stringency 5 --length 10'
    }

    withName: KNEADDATA {
        // --serial chains the databases so a read matching several is attributed to one.
        ext.args = "--trimmomatic-options 'HEADCROP:15 SLIDINGWINDOW:4:15 MINLEN:50' --reorder --remove-intermediate-output --bypass-trf --serial"
    }

    withName: SUMMARY_KNEADDATA {
        ext.args = "--max-plot-samples ${params.qc_max_plot_samples}"
    }

}

