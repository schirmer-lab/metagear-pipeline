process {

    withName: VIRSORTER2_4DRAMV {
        // ext.args = '--keep-original-seq --seqname-suffix-off --viral-gene-enrich-off --provirus-off --prep-for-dramv --include-groups dsDNAphage,NCLDV,RNA,ssDNA,lavidaviridae --min-length 1000 --min-score 0.5'
        //ext.args = '--keep-original-seq --seqname-suffix-off --viral-gene-enrich-off --provirus-off --prep-for-dramv --include-groups dsDNAphage,NCLDV,RNA,ssDNA,lavidaviridae --min-length 1000 --min-score 0.5 --max-orf-per-seq 50'
        ext.args = '--keep-original-seq --seqname-suffix-off --viral-gene-enrich-off --provirus-off --prep-for-dramv --include-groups dsDNAphage,ssDNA,NCLDV,lavidaviridae --min-length 1500 --min-score 0.5'
        ext.args2 = '.4dramv'


        publishDir = [
            path: { "${params.outdir}/virus/virsorter2" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: DRAMV {
        ext.args = '--skip_trnascan --min_contig_size 1500'


        publishDir = [
            path: { "${params.outdir}/virus/dramv/parts" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: IPHOP_PREDICT {

        publishDir = [
            path: { "${params.outdir}/virus/iphop/parts" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-batch chunks for both SEQKIT_SPLIT2 (feeds VIRSORTER2_4DRAMV + DRAMV)
    // and SEQKIT_SPLIT2_IPHOP (feeds IPHOP_PREDICT) are pipeline-internal
    // intermediates consumed only via Nextflow channels. The cohort virus
    // representative FASTA is already published under catalogs/, so the
    // chunks have no standalone value. Suppressing publish also removes a
    // latent clobber: both processes derive `virus.representative.part_NNN.fa.gz`
    // filenames from the same input, and the default modules.config publishDir
    // would race them into the same seqkit/virus/ directory.
    withName: '.*:VIRAL_ANNOTATION:SEQKIT_SPLIT2' {

        // ext.args = '-s 50000 -e ".gz"'
        ext.args = "-s ${params.viral_sequences_batch_size} -e '.gz'"

        publishDir = [ enabled: false ]
    }

    // IPHOP-only split. Same input as SEQKIT_SPLIT2 above but a smaller `-s`
    // so each IPHOP batch finishes in <24 h. Process name has to be the
    // alias used in subworkflows/local/virus/annotation.nf
    // (`SEQKIT_SPLIT2 as SEQKIT_SPLIT2_IPHOP`) so this withName actually
    // matches the second invocation only.
    withName: '.*:VIRAL_ANNOTATION:SEQKIT_SPLIT2_IPHOP' {

        ext.args = "-s ${params.iphop_batch_size} -e '.gz'"

        publishDir = [ enabled: false ]
    }

    withName: '.*:VIRAL_ANNOTATION:PHAROKKA_PROTEINS' {

        ext.args = "--mmseqs2_only"


        publishDir = [
            path: { "${params.outdir}/virus/pharokka" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }


}
