process {

    withName: VIRSORTER2_4DRAMV {
        ext.args = '--keep-original-seq --seqname-suffix-off --viral-gene-enrich-off --provirus-off --prep-for-dramv --include-groups dsDNAphage,ssDNA,NCLDV,lavidaviridae --min-length 1500 --min-score 0.5'
        ext.args2 = '.4dramv'


        publishDir = [
            path: { "${params.outdir}/virus/virsorter2" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: DRAMV {
        ext.args = '--skip_trnascan --min_contig_size 1500'


        publishDir = [
            path: { "${params.outdir}/virus/dramv/parts" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: IPHOP_PREDICT {

        publishDir = [
            path: { "${params.outdir}/virus/iphop/parts" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: PHABOX2_PHATYP {

        // Overrides phabox2's default of 3000, which on an assembly-derived
        // catalog classifies the long, complete minority only: measured on 90,705
        // vOTU clusters with a median representative of 1,626 bp, 3000 classifies
        // 35.0% and 1000 classifies 64.2%. Shorter contigs are not dropped, they
        // come back as TYPE = filtered. PhaTYP is built for fragments, so this is
        // within its design.
        ext.args = "--len 1000"

        publishDir = [
            path: { "${params.outdir}/virus/lifestyle/phatyp/parts" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Publishing is off partly to avoid a clobber: both split processes derive
    // the same part filenames from the same input, and the default publishDir
    // would race them into one directory.
    withName: '.*:VIRAL_ANNOTATION:SEQKIT_SPLIT2' {

        ext.args = "-s ${params.viral_sequences_batch_size} -e '.gz'"

        publishDir = [ enabled: false ]
    }

    // Smaller batches than the split above so an iPHoP batch fits a 24 h window.
    // The name is the subworkflow's alias, which is what scopes this to the
    // second invocation.
    withName: '.*:VIRAL_ANNOTATION:SEQKIT_SPLIT2_IPHOP' {

        ext.args = "-s ${params.iphop_batch_size} -e '.gz'"

        publishDir = [ enabled: false ]
    }

    withName: '.*:VIRAL_ANNOTATION:PHAROKKA_PROTEINS' {

        ext.args = "--mmseqs2_only"


        publishDir = [
            path: { "${params.outdir}/virus/pharokka" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }


}
