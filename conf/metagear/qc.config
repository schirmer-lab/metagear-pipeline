// Quality control for both assays. --assay dna reads qc_dna_refdb, --assay rna reads
// qc_rna_refdb; everything else is identical, which is why there is one workflow.

params {

    qc_max_plot_samples = 100  // beyond this the report drops the bar plot for the table

}

process {

    withName: TRIMGALORE {
        ext.args = '--phred33 --quality 0 --stringency 5 --length 10'
    }

    withName: KNEADDATA {
        // --serial chains the databases so per-database counts partition the reads.
        ext.args = "--trimmomatic-options 'HEADCROP:15 SLIDINGWINDOW:4:15 MINLEN:50' --reorder --remove-intermediate-output --bypass-trf --serial"
    }

    // At the top of the results tree rather than in a subdirectory: it is the thing somebody
    // picks up to start the next run, and the prefix already says which assay it came from.
    withName: CLEAN_SAMPLESHEET {
        publishDir = [
            path: { "${params.outdir}" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUMMARY_KNEADDATA {
        ext.args = "--max-plot-samples ${params.qc_max_plot_samples}"
    }

}
