process {

    withName: '.*:CLASSIFICATION:TIARA_TIARA' {

        publishDir = [
            path: { "${params.outdir}/classification/tiara" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:CLASSIFICATION:EXTRACT_UNBINNED' {

        publishDir = [
            path: { "${params.outdir}/classification/unbinned" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Opt-in via --enable_contig_taxonomy and skipped by default: per-contig LCA
    // on unbinned contigs is low-confidence, the merge reads only the first
    // lineage rank, and the GTDB database is around 200 GiB.
    //
    // The args trade sensitivity for speed, which domain-level assignment
    // tolerates. --split-memory-limit is set from task.memory because mmseqs
    // otherwise sizes itself from host memory, not from its allocation.
    //
    // Memory floor: below roughly 96 GiB the prefilter cannot hold a chunk of
    // the GTDB index, and no combination of these args lowers that, since it
    // follows from the target database rather than the query.
    withName: '.*:CLASSIFICATION:MMSEQS_EASYTAXONOMY' {

        ext.args = { def mem_g = task.memory ? Math.max(8, (task.memory.toGiga() * 0.7).intValue()) : 16
                     "--tax-lineage 1 --orf-filter 1 --lca-mode 1 -s 2.0 --max-accept 30 " +
                     "--split-memory-limit ${mem_g}G --remove-tmp-files 1" }

        publishDir = [
            path: { "${params.outdir}/classification/contig_taxonomy/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:CLASSIFICATION:MERGE_CONTIG_CLASSIFICATION' {

        publishDir = [
            path: { "${params.outdir}/classification/per_contig" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Renamed to .refined so it sits beside the .draft and .raw siblings that
    // virus.config routes into classification/.
    withName: '.*:CLASSIFICATION:CLASSIFY_GENES' {

        publishDir = [
            path: { "${params.outdir}/classification" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename == 'versions.yml')                          return null
                if (filename == 'all.genes.clusters.classified.tsv')     return 'all.genes.clusters.classified.refined.tsv'
                return filename
            }
        ]
    }

}
