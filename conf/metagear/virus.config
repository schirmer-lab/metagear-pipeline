process {

    // The .contigs. in the filename keeps this distinct from the gene-level
    // catalog once a file is extracted from the tree.
    withName: '.*:VIRUS:CLUSTER_VIRUS:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.85 --cov-mode 5 --alignment-mode 3 --wrapped-scoring 1 --db-load-mode 2 --shuffle 0 --remove-tmp-files 0 --max-seq-len 65535"
        ext.method = "easy-linclust"


        publishDir = [
            path: { "${params.outdir}/catalogs/contigs" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.equals('virus.clusters.tsv'))         return 'virus.contigs.clusters.tsv'
                if (filename.equals('virus.representative.fa.gz')) return 'virus.contigs.representative.fa.gz'
                return filename
            }
        ]
    }

    // Same publish paths as the MMseqs2 branch, so the catalog's location does
    // not depend on which criterion produced it. The thresholds are the MIUViG
    // species definition: 95% ANI over merged local alignments, and 85% coverage
    // of the shorter sequence, which MMseqs2's --cov-mode 5 does not check. The
    // k-mer prefilter sits below the clustering threshold so no pair that could
    // cluster is dropped before alignment.
    withName: '.*:VIRUS:CLUSTER_VIRUS:VCLUST_CLUSTER' {

        ext.args  = "--min-ident 0.90"
        ext.args2 = "--outfmt lite"
        ext.args3 = "--algorithm single --metric ani --ani 0.95 --rcov 0.85"

        publishDir = [
            path: { "${params.outdir}/catalogs/contigs" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.equals('virus.clusters.tsv'))         return 'virus.contigs.clusters.tsv'
                if (filename.equals('virus.representative.fa.gz')) return 'virus.contigs.representative.fa.gz'
                // Published because it is what makes a merge auditable afterwards, and it
                // is what a different threshold can be re-clustered from without realigning.
                if (filename.equals('virus.ani.tsv'))              return 'virus.contigs.ani.tsv'
                return null
            }
        ]
    }

    withName: '.*:VIRUS:CLUSTER_PLASMID:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.90 --cov-mode 2 --alignment-mode 3 --wrapped-scoring 1"


        publishDir = [
            path: { "${params.outdir}/catalogs/contigs" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.equals('plasmid.clusters.tsv'))         return 'plasmid.contigs.clusters.tsv'
                if (filename.equals('plasmid.representative.fa.gz')) return 'plasmid.contigs.representative.fa.gz'
                return filename
            }
        ]
    }

    // The rename is publish-time only: work-dir filenames stay as the module
    // emits them, so the downstream meta.id filter is unaffected.
    withName: 'COLLECT_TABLES' {

        publishDir = [
            // → virus/detection/   (cohort-aggregated per-sample call catalogs)
            [
                path  : { "${params.outdir}/virus/detection" },
                mode  : "copy",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.equals('virus_checkv_summary_taxa.tsv'))          return 'virus.calls.tsv'
                    if (filename.equals('virus.filtered_checkv_summary_taxa.tsv')) return 'virus.calls.filtered.tsv'
                    if (filename.equals('plasmid_summary.tsv'))                     return 'plasmid.calls.tsv'
                    if (filename.equals('plasmid.filtered_summary.tsv'))            return 'plasmid.calls.filtered.tsv'
                    return null   // AMG + host handled by the next branch
                }
            ],
            // → virus/lifestyle/   (vOTU-level life-history annotations)
            [
                path  : { "${params.outdir}/virus/lifestyle" },
                mode  : "copy",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.equals('amg_summary.tsv'))         return 'virus.amgs.tsv'
                    if (filename.equals('host.genome_summary.tsv')) return 'virus.host.genome.tsv'
                    if (filename.equals('host.genus_summary.tsv'))  return 'virus.host.genus.tsv'
                    // PhaTYP goes a level down: this directory held only host predictions and
                    // AMG calls, so its name promised a lifestyle classification that did not
                    // exist.
                    if (filename.equals('lifestyle_summary.tsv')) return 'phatyp/virus.lifestyle.tsv'
                    return null   // detection tables handled by the first branch
                }
            ]
        ]
    }

    withName: 'FIND_REPRESENTATIVES' {

        publishDir = [
            // → catalogs/genes/  (gene catalog reps + clusters)
            [
                path  : { "${params.outdir}/catalogs/genes" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.endsWith('.genes.representative.fa.gz')) return fn
                    if (fn.endsWith('.genes.clusters.tsv'))         return fn
                    return null
                }
            ],
            // → catalogs/proteins/  (protein catalog reps for virus/plasmid)
            [
                path  : { "${params.outdir}/catalogs/proteins" },
                mode  : 'copy',
                saveAs: { fn -> fn.endsWith('.proteins.representative.fa.gz') ? fn : null }
            ],
            // pure_representatives is renamed to <class>-exclusive so it reads as a
            // sibling class of <class> rather than as an opaque qualifier. Nothing
            // downstream consumes it, so only the published name changes.
            [
                path  : { "${params.outdir}/virus/clusters" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.endsWith('.pure_representatives.txt')) {
                        def cls = fn.replaceFirst(/\.genes\.pure_representatives\.txt$/, '')
                        return "${cls}-exclusive.genes.representative_ids.txt"
                    }
                    return (fn.endsWith('.representative_ids.txt') || fn.endsWith('.clusters.annotated.tsv')) ? fn : null
                }
            ]
        ]
    }

    withName: 'MERGE_CLUSTER_ANNOTATIONS' {

        // Renamed into a .classified.<stage>.tsv series under classification/,
        // alongside classification's own outputs. The module still emits the
        // legacy names, so consumers reading by emit name keep working. Do not
        // describe these tables' contents here; docs/output.md does that.
        publishDir = [
            path: { "${params.outdir}/classification" },
            mode: "copy",
            saveAs: { filename ->
                if (filename == 'versions.yml')                            return null
                if (filename == 'all.genes.clusters.annotated.tsv')        return 'all.genes.classified.raw.tsv'
                if (filename == 'all.genes.clusters.aggregated.tsv')       return 'all.genes.clusters.classified.draft.tsv'
                return filename
            }
        ]
    }


    withName: 'EXTRACT_AMGS' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_EASYSEARCH' {


        ext.args = '--alignment-mode 3 --min-seq-id 0.95 --cov-mode 0 -c 0.9 --format-output "query,target,pident,qcov,tcov,evalue,bits"'

        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAP_AMG_CATALOG' {

        publishDir = [
            // → abundance/virus/  (AMG abundance matrices)
            [
                path  : { "${params.outdir}/abundance/virus" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.equals('virus.amg_count.tsv')) return 'virus.amg.count.tsv'
                    if (fn.equals('virus.amg_rpkm.tsv'))  return 'virus.amg.rpkm.tsv'
                    if (fn.equals('virus.amg_tpm.tsv'))   return 'virus.amg.tpm.tsv'
                    return null
                }
            ],
            // → virus/lifestyle/  (AMG → gene catalog cross-reference)
            [
                path  : { "${params.outdir}/virus/lifestyle" },
                mode  : 'copy',
                saveAs: { fn -> fn.equals('amg_to_catalog.tsv') ? 'virus.amg_to_catalog.tsv' : null }
            ],
            // → virus/dramv/  (supporting AMG ID list)
            [
                path  : { "${params.outdir}/virus/dramv" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.equals('versions.yml')) return null
                    if (fn.equals('amg_catalog_ids.txt')) return fn
                    return null   // abundance + lifestyle artefacts handled above
                }
            ]
        ]
    }


}
