includeConfig "${projectDir}/conf/metagear/gene_call.config"
includeConfig "${projectDir}/conf/metagear/gene_abundance.config"
includeConfig "${projectDir}/conf/metagear/protein_annotation.config"
includeConfig "${projectDir}/conf/metagear/viral_detection.config"
includeConfig "${projectDir}/conf/metagear/viral_annotation.config"

params {
    catalog_derep_min_seq_identity = 0.95
    catalog_derep_min_coverage = 0.80
}

process {

    withName: '.*:VIRAL_ANALYSIS:VIRAL_DETECTION:MMSEQS_EASY_CLUSTER' {
        ext.args = "--min-seq-id ${params.catalog_derep_min_seq_identity} -c ${params.catalog_derep_min_coverage} --cov-mode 1"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VIRAL_ANALYSIS:VIRAL_DETECTION:VAMB_CONCATENATE_FASTA' {
        ext.args = "-m 1000 --keepnames"
        ext.args2 = "--catalog_name catalog"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/catalogs/raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BWA_INDEX' {

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/coverm" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_MAKE' {
        ext.args = "-p bwa-mem"

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/coverm" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.startsWith('out/') ? filename.replace('out/', 'bam/') : filename }
        ]
    }

    withName: '.*:ABUNDANCE:COVERM_CONTIG' {
        ext.args = "--min-read-percent-identity 95 --min-read-aligned-percent 75" // Count
        ext.args2 = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 20" // RPKM, TPM

        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time

        publishDir = [
            path: { "${params.outdir}/coverm/tables_raw" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


}
