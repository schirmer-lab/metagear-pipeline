process {

    // ─── Cohort viral contig clustering (vOTUs) ──────────────────────────────
    // CLUSTER_VIRUS produces the dereplicated viral contig catalog. Lives
    // under catalogs/contigs/ with explicit `.contigs.` in the filename so
    // users can disambiguate from the gene-level catalog when files are
    // extracted from the tree.
    withName: '.*:VIRAL_ANALYSIS:CLUSTER_VIRUS:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.85 --cov-mode 5 --alignment-mode 3 --wrapped-scoring 1 --db-load-mode 2 --shuffle 0 --remove-tmp-files 0 --max-seq-len 65535"
        ext.method = "easy-linclust"


        publishDir = [
            path: { "${params.outdir}/catalogs/contigs" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                //   virus.clusters.tsv          → virus.contigs.clusters.tsv
                //   virus.representative.fa.gz  → virus.contigs.representative.fa.gz
                if (filename.equals('virus.clusters.tsv'))         return 'virus.contigs.clusters.tsv'
                if (filename.equals('virus.representative.fa.gz')) return 'virus.contigs.representative.fa.gz'
                return filename
            }
        ]
    }

    withName: '.*:VIRAL_ANALYSIS:CLUSTER_PLASMID:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.90 --cov-mode 2 --alignment-mode 3 --wrapped-scoring 1"


        publishDir = [
            path: { "${params.outdir}/catalogs/contigs" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.equals('plasmid.clusters.tsv'))         return 'plasmid.contigs.clusters.tsv'
                if (filename.equals('plasmid.representative.fa.gz')) return 'plasmid.contigs.representative.fa.gz'
                return filename
            }
        ]
    }

    // ─── Cohort detection & lifestyle tables (vOTU-level deliverables) ───────
    // COLLECT_TABLES concatenates per-sample/per-batch outputs into cohort-wide
    // tables. Two semantically different categories ride this process:
    //
    //   1. Detection — pre-cluster per-sample calls (geNomad + CheckV)
    //        virus.calls.tsv / virus.calls.filtered.tsv
    //        plasmid.calls.tsv / plasmid.calls.filtered.tsv
    //      Each row is a per-sample virus/plasmid identification (with sample
    //      column). NOT a vOTU/pOTU — those live in catalogs/contigs/.
    //
    //   2. Lifestyle — vOTU-level life-history annotations (DRAM-V + iPHoP)
    //        virus.amgs.tsv             (AMG identifications on the vOTU catalog)
    //        virus.host.{genome,genus}.tsv (predicted hosts of vOTUs)
    //      Each row is a per-vOTU annotation. These pipelines run on
    //      CLUSTER_VIRUS.out.representative — they see vOTUs only.
    //
    // Pure publish-time rename — the work-dir filenames stay as the module
    // emits them, so ch_amg_postprocess's meta.id-based filter is unaffected.
    withName: 'COLLECT_TABLES' {

        publishDir = [
            // → virus/detection/   (cohort-aggregated per-sample call catalogs)
            [
                path  : { "${params.outdir}/virus/detection" },
                mode  : "copy",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    //   virus_checkv_summary_taxa.tsv           → virus.calls.tsv
                    //   virus.filtered_checkv_summary_taxa.tsv  → virus.calls.filtered.tsv
                    //   plasmid_summary.tsv                     → plasmid.calls.tsv
                    //   plasmid.filtered_summary.tsv            → plasmid.calls.filtered.tsv
                    if (filename.equals('virus_checkv_summary_taxa.tsv'))          return 'virus.calls.tsv'
                    if (filename.equals('virus.filtered_checkv_summary_taxa.tsv')) return 'virus.calls.filtered.tsv'
                    if (filename.equals('plasmid_summary.tsv'))                     return 'plasmid.calls.tsv'
                    if (filename.equals('plasmid.filtered_summary.tsv'))            return 'plasmid.calls.filtered.tsv'
                    return null   // AMG + host handled by the next branch
                }
            ],
            // → virus/lifestyle/   (vOTU-level life-history annotations)
            [
                path  : { "${params.outdir}/virus/lifestyle" },
                mode  : "copy",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    if (filename.equals('amg_summary.tsv'))         return 'virus.amgs.tsv'
                    if (filename.equals('host.genome_summary.tsv')) return 'virus.host.genome.tsv'
                    if (filename.equals('host.genus_summary.tsv'))  return 'virus.host.genus.tsv'
                    return null   // detection tables handled by the first branch
                }
            ]
        ]
    }

    withName: 'FIND_REPRESENTATIVES' {

        // FIND_REPRESENTATIVES emits per-class (virus.genes / plasmid.genes):
        //   *.genes.representative.fa.gz       — gene catalog reps
        //   *.proteins.representative.fa.gz    — protein catalog reps (optional)
        //   *.genes.clusters.tsv               — gene cluster table
        //   *.representative_ids.txt           — rep ID list
        //   *.pure_representatives.txt         — homogeneous-cluster rep ID list
        //   *.clusters.annotated.tsv           — annotated cluster table
        //
        // Routed across three destinations so each lives with its sibling
        // artefacts:
        //   catalogs/genes/    — gene catalog rep FASTAs + clusters
        //   catalogs/proteins/ — protein catalog rep FASTAs
        //   virus/clusters/    — class-scoped clustering artefacts
        publishDir = [
            // → catalogs/genes/  (gene catalog reps + clusters)
            [
                path  : { "${params.outdir}/catalogs/genes" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.endsWith('.genes.representative.fa.gz')) return fn
                    if (fn.endsWith('.genes.clusters.tsv'))         return fn
                    return null
                }
            ],
            // → catalogs/proteins/  (protein catalog reps for virus/plasmid)
            [
                path  : { "${params.outdir}/catalogs/proteins" },
                mode  : 'copy',
                saveAs: { fn -> fn.endsWith('.proteins.representative.fa.gz') ? fn : null }
            ],
            // → virus/clusters/  (virus/plasmid-scoped cluster artefacts).
            // Renames `<class>.genes.pure_representatives.txt` to
            // `<class>-exclusive.genes.representative_ids.txt` so the
            // homogeneous-cluster subset reads as a sibling semantic class
            // ("virus" = touching, "virus-exclusive" = all members in class)
            // instead of the opaque "pure" qualifier. The renamed name
            // doesn't affect any in-pipeline channel — pure_representatives
            // is emitted but never consumed downstream.
            [
                path  : { "${params.outdir}/virus/clusters" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.endsWith('.pure_representatives.txt')) {
                        def cls = fn.replaceFirst(/\.genes\.pure_representatives\.txt$/, '')
                        return "${cls}-exclusive.genes.representative_ids.txt"
                    }
                    return (fn.endsWith('.representative_ids.txt') || fn.endsWith('.clusters.annotated.tsv')) ? fn : null
                }
            ]
        ]
    }

    withName: 'MERGE_CLUSTER_ANNOTATIONS' {

        // Cohort-wide gene cluster classification artefacts live under
        // classification/, the content-described directory shared with
        // integrated_classification's outputs. Filenames are rewritten via
        // saveAs to a consistent .classified.<stage>.tsv series:
        //
        //   all.genes.clusters.annotated.tsv   → all.genes.classified.raw.tsv
        //         (per-gene row, viral_analysis labels only — "raw" because it
        //          is per-row evidence rather than aggregated per cluster.)
        //
        //   all.genes.clusters.aggregated.tsv  → all.genes.clusters.classified.draft.tsv
        //         (per-cluster representative, viral/plasmid labels only — "draft"
        //          because it lacks bacteria/archaea/eukaryote/unknown coverage;
        //          integrated_classification's CLASSIFY_GENES adds the .refined sibling.)
        //
        // The module itself still emits the legacy filenames so downstream
        // consumers that read by emit name keep working (gene_analysis's MSP
        // step etc.). Only the published copy is renamed. Outputs are additive
        // across workflows — no overwrite ever.
        publishDir = [
            path: { "${params.outdir}/classification" },
            mode: "copy",
            saveAs: { filename ->
                if (filename == 'versions.yml')                            return null
                if (filename == 'all.genes.clusters.annotated.tsv')        return 'all.genes.classified.raw.tsv'
                if (filename == 'all.genes.clusters.aggregated.tsv')       return 'all.genes.clusters.classified.draft.tsv'
                return filename
            }
        ]
    }


    withName: 'EXTRACT_AMGS' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_EASYSEARCH' {


        ext.args = '--alignment-mode 3 --min-seq-id 0.95 --cov-mode 0 -c 0.9 --format-output "query,target,pident,qcov,tcov,evalue,bits"'

        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAP_AMG_CATALOG' {

        // Triple publishDir routes the MAP_AMG_CATALOG outputs by audience:
        //   abundance/virus/         — AMG abundance matrices (per-sample × AMG counts)
        //   virus/lifestyle/         — the AMG→catalog cross-reference (primary
        //                              user-facing deliverable: links DRAM-V
        //                              AMG annotations to the cohort gene catalog)
        //   virus/dramv/             — supporting ID lists (amg_catalog_ids.txt)
        publishDir = [
            // → abundance/virus/  (AMG abundance matrices)
            [
                path  : { "${params.outdir}/abundance/virus" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.equals('virus.amg_count.tsv')) return 'virus.amg.count.tsv'
                    if (fn.equals('virus.amg_rpkm.tsv'))  return 'virus.amg.rpkm.tsv'
                    if (fn.equals('virus.amg_tpm.tsv'))   return 'virus.amg.tpm.tsv'
                    return null
                }
            ],
            // → virus/lifestyle/  (AMG → gene catalog cross-reference)
            [
                path  : { "${params.outdir}/virus/lifestyle" },
                mode  : 'copy',
                saveAs: { fn -> fn.equals('amg_to_catalog.tsv') ? 'virus.amg_to_catalog.tsv' : null }
            ],
            // → virus/dramv/  (supporting AMG ID list)
            [
                path  : { "${params.outdir}/virus/dramv" },
                mode  : 'copy',
                saveAs: { fn ->
                    if (fn.equals('versions.yml')) return null
                    if (fn.equals('amg_catalog_ids.txt')) return fn
                    return null   // abundance + lifestyle artefacts handled above
                }
            ]
        ]
    }


}
