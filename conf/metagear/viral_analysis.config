process {

    withName: '.*:VIRAL_ANALYSIS:CLUSTER_VIRUS:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.85 --cov-mode 5 --alignment-mode 3 --wrapped-scoring 1 --db-load-mode 2 --shuffle 0 --remove-tmp-files 0 --max-seq-len 65535"
        ext.method = "easy-linclust"


        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VIRAL_ANALYSIS:CLUSTER_PLASMID:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.90 --cov-mode 2 --alignment-mode 3 --wrapped-scoring 1"


        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COLLECT_TABLES' {


        publishDir = [
            path: { "${params.outdir}/virus/collect" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.startsWith('out/') ? filename.replace('out/', 'bam/') : filename }
        ]
    }

    withName: 'FIND_REPRESENTATIVES' {


        // Route files by name to different destinations
        publishDir = [
            // → {outdir}/catalogs
            [
                path   : { "${params.outdir}/catalogs" },
                mode   : 'copy',
                saveAs : { fn -> (fn.endsWith('.clusters.tsv') || fn.endsWith('.representative.fa.gz')) ? fn : null }
            ],
            // → {outdir}/virus/viral_clusters (everything else we care about)
            [
                path   : { "${params.outdir}/virus/viral_clusters" },
                mode   : 'copy',
                saveAs : { fn -> (fn.endsWith('.representative_ids.txt') || fn.endsWith('.pure_representatives.txt') || fn.endsWith('.clusters.annotated.tsv') ) ? fn : null }
            ]
        ]
    }

    withName: 'MERGE_CLUSTER_ANNOTATIONS' {


        publishDir = [
            path: { "${params.outdir}/virus/viral_clusters" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'EXTRACT_AMGS' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_EASYSEARCH' {


        ext.args = '--alignment-mode 3 --min-seq-id 0.95 --cov-mode 0 -c 0.9 --format-output "query,target,pident,qcov,tcov,evalue,bits"'

        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAP_AMG_CATALOG' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

        // Route files by name to different destinations
        publishDir = [
            // → {outdir}/coverm
            [
                path   : { "${params.outdir}/coverm" },
                mode   : 'copy',
                saveAs : { fn -> (fn.equals('virus.amg_tpm.tsv') || fn.equals('virus.amg_rpkm.tsv') || fn.equals('virus.amg_count.tsv')) ? fn : null }
            ],
            // → {outdir}/virus/dramv (everything else we care about)
            [
                path   : { "${params.outdir}/virus/dramv" },
                mode   : 'copy',
                saveAs : { fn -> (fn.endsWith('.txt') || fn.equals('amg_to_catalog.tsv') || fn.endsWith('.fna') || fn.endsWith('.faa') ) ? fn : null }
            ]
        ]
    }


}
