process {

    withName: '.*:VIRAL_ANALYSIS:CLUSTER_VIRUS:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.85 --cov-mode 5 --alignment-mode 3 --wrapped-scoring 1 --db-load-mode 2 --shuffle 0 --remove-tmp-files 0 --max-seq-len 65535"
        ext.method = "easy-linclust"


        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VIRAL_ANALYSIS:CLUSTER_PLASMID:MMSEQS_EASY_CLUSTER' {

        ext.args = "--min-seq-id 0.95 -c 0.90 --cov-mode 2 --alignment-mode 3 --wrapped-scoring 1"


        publishDir = [
            path: { "${params.outdir}/catalogs" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COLLECT_TABLES' {


        publishDir = [
            path: { "${params.outdir}/virus/collect" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.startsWith('out/') ? filename.replace('out/', 'bam/') : filename }
        ]
    }

    withName: 'FIND_REPRESENTATIVES' {


        // Route files by name to different destinations.
        publishDir = [
            // catalogs/ — gene catalog representatives + cluster TSVs
            [
                path   : { "${params.outdir}/catalogs" },
                mode   : 'copy',
                saveAs : { fn -> (fn.endsWith('.clusters.tsv') || fn.endsWith('.representative.fa.gz')) ? fn : null }
            ],
            // virus/clusters/ — virus/plasmid-specific cluster artefacts.
            // Renames `<class>.genes.pure_representatives.txt` on publish to
            // `<class>-exclusive.genes.representative_ids.txt`, so the
            // homogeneous-cluster subset reads as a sibling semantic class
            // ("virus" = touching, "virus-exclusive" = all members in class)
            // instead of the opaque "pure" qualifier. The renamed name
            // doesn't affect any in-pipeline channel — pure_representatives
            // is emitted but never consumed downstream.
            [
                path   : { "${params.outdir}/virus/clusters" },
                mode   : 'copy',
                saveAs : { fn ->
                    if (fn.endsWith('.pure_representatives.txt')) {
                        def cls = fn.replaceFirst(/\.genes\.pure_representatives\.txt$/, '')
                        return "${cls}-exclusive.genes.representative_ids.txt"
                    }
                    return (fn.endsWith('.representative_ids.txt') || fn.endsWith('.clusters.annotated.tsv')) ? fn : null
                }
            ]
        ]
    }

    withName: 'MERGE_CLUSTER_ANNOTATIONS' {

        // Cohort-wide gene cluster annotations live at top-level clusters/
        // so future workflows (e.g. integrated_classification) can add
        // sibling files like all.genes.clusters.aggregated.with_contig_classes.tsv
        // without ever colliding. Pipeline outputs are additive across
        // workflows — never override.
        publishDir = [
            path: { "${params.outdir}/clusters" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'EXTRACT_AMGS' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_EASYSEARCH' {


        ext.args = '--alignment-mode 3 --min-seq-id 0.95 --cov-mode 0 -c 0.9 --format-output "query,target,pident,qcov,tcov,evalue,bits"'

        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAP_AMG_CATALOG' {


        publishDir = [
            path: { "${params.outdir}/virus/dramv" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

        // Route files by name to different destinations
        publishDir = [
            // → {outdir}/coverm
            [
                path   : { "${params.outdir}/coverm" },
                mode   : 'copy',
                saveAs : { fn -> (fn.equals('virus.amg_tpm.tsv') || fn.equals('virus.amg_rpkm.tsv') || fn.equals('virus.amg_count.tsv')) ? fn : null }
            ],
            // → {outdir}/virus/dramv (everything else we care about)
            [
                path   : { "${params.outdir}/virus/dramv" },
                mode   : 'copy',
                saveAs : { fn -> (fn.endsWith('.txt') || fn.equals('amg_to_catalog.tsv') || fn.endsWith('.fna') || fn.endsWith('.faa') ) ? fn : null }
            ]
        ]
    }


}
