// Workflow-level config for the `dereplication` entry workflow.
//
// Inputs (params): see workflow_definitions.json. Reuses bin and per-contig
// TSV outputs from a prior `integrated_classification` run.

process {

    // ─── Internal staging steps (no publishing) ──────────────────────────────
    // STAGE_DREP_WORK + GATHER_GENOMES_DIR produce intermediates that downstream
    // processes consume via channels, not via published paths. Without explicit
    // overrides here, conf/modules.config's default publishDir would route them
    // to ${outdir}/stage/ and ${outdir}/gather/ at the top level — confusing
    // leakage of internal staging into the user-visible tree.
    withName: '.*:DEREPLICATION:STAGE_DREP_WORK'    { publishDir = [ enabled: false ] }
    withName: '.*:DEREPLICATION:GATHER_GENOMES_DIR' { publishDir = [ enabled: false ] }

    // ─── dRep ────────────────────────────────────────────────────────────────
    // --S_algorithm skani:       fast secondary clustering (vs the default
    //                            ANImf). Equivalent ANI accuracy at the 95%
    //                            species threshold.
    // --genomeInfo drep_work/…:  STAGE_DREP_WORK pre-stages the cohort
    //                            genomeInfo CSV inside drep_work/. Passing
    //                            this lets dRep skip its internal CheckM run
    //                            (we already have Binette's CheckM2 numbers).
    // -comp 50 / -con 10:        MIMAG MQ+ inclusion threshold. Binette
    //                            already filters at --min_completeness 50;
    //                            -con 10 lets a few mildly contaminated MQ
    //                            bins through that Binette would otherwise
    //                            keep but you'd want to flag.
    // Dual publishDir splits dRep outputs by audience:
    //   assemblies/dereplicated/<file>.fa        (cluster-winner MAG sequences)
    //   dereplication/drep/{data_tables,figures,log,logger.log}/  (rest)
    //
    // The data_tables/ subdir (Cdb.csv, Wdb.csv, etc.) and figures/ stay in
    // dereplication/ since they're cohort-level tables, not sequence
    // deliverables. FASTAs concentrate under assemblies/ alongside the
    // per-sample bins and the cohort catalog.
    withName: '.*:DEREPLICATION:DREP_DEREPLICATE' {

        // Path note: STAGE_DREP_WORK emits a directory `drep_work_seed/`
        // containing genomeInfo.csv. Nextflow's `stageAs: 'drep_work/'` on
        // DREP's input preserves the source dir name INSIDE the target, so
        // the file lands at `drep_work/drep_work_seed/genomeInfo.csv` — not
        // `drep_work/genomeInfo.csv`. We point --genomeInfo at the nested
        // path explicitly rather than fight the staging behavior.
        ext.args = '--S_algorithm skani --genomeInfo drep_work/drep_work_seed/genomeInfo.csv -comp 50 -con 10'

        publishDir = [
            // → assemblies/dereplicated/   (cluster winners)
            [
                path  : { "${params.outdir}/assemblies/dereplicated" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // DREP_DEREPLICATE emits dereplicated_genomes/*.fa.
                    // Strip the subdir prefix so files sit directly under
                    // assemblies/dereplicated/.
                    if (filename.startsWith('dereplicated_genomes/'))
                        return filename.replaceFirst(/^dereplicated_genomes\//, '')
                    return null
                }
            ],
            // → dereplication/drep/   (cluster tables, figures, log)
            [
                path  : { "${params.outdir}/dereplication/drep" },
                mode  : 'copy',
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) return null
                    // Skip the dereplicated FASTAs (handled by the first publishDir).
                    if (filename.startsWith('dereplicated_genomes/')) return null
                    return filename
                }
            ]
        ]
    }

    // ─── Cohort MAG catalog (FASTA + lookups) ────────────────────────────────
    // The MAG catalog is the cohort-level dereplicated representative genome
    // set — exactly what catalogs/<class>/ holds for genes/proteins/contigs.
    // Lives at catalogs/mag/ alongside catalogs/genes/, catalogs/proteins/, etc.
    // Individual cluster-winner MAG FASTAs stay at assemblies/dereplicated/
    // for downstream tools that want a directory of per-genome files (e.g.
    // GTDB-Tk).
    withName: '.*:DEREPLICATION:BUILD_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/catalogs/mag" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Rename mag_catalog.fa.gz → mag.representative.fa.gz so the
                // representative-FASTA naming matches catalogs/genes/all.genes
                // .representative.fa.gz etc. The contig_to_mag.tsv and
                // mag_contig_lengths.tsv stay as-is (descriptive and unique).
                if (filename == 'mag_catalog.fa.gz') return 'mag.representative.fa.gz'
                return filename
            }
        ]
    }

    // ─── Cohort MAG-catalog abundance ────────────────────────────────────────
    // BWA_INDEX / COVERM_MAKE / COVERM_GENOME / COVERM_CONTIG_MERGE are shared
    // with the contig-mode ABUNDANCE flow used by gene_analysis + viral_analysis.
    // Route MAG-catalog outputs into ${outdir}/abundance/mag/ — MAG abundance
    // is just another class of per-sample abundance from the user's perspective,
    // and the mag/ subdir slots in alongside abundance/{all.genes,virus,plasmid}/
    // with the same {bams, bwa_index, per_batch, <class>.<metric>.tsv} shape.
    withName: '.*:DEREPLICATION:.*:BWA_INDEX' {

        publishDir = [
            path: { "${params.outdir}/abundance/mag/bwa_index" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:DEREPLICATION:.*:COVERM_MAKE' {

        ext.args = "-p bwa-mem"

        publishDir = [
            path: { "${params.outdir}/abundance/mag/bams" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:DEREPLICATION:.*:COVERM_GENOME' {

        // Mirror COVERM_CONTIG's read-identity / aligned-percent thresholds.
        // CoverM `genome` defaults --min-covered-fraction to 0.10 (the
        // `contig` subcommand defaults it to 0), which BREAKS the `count`
        // method — coverm refuses to run count + nonzero min-covered-fraction
        // since count doesn't compute the covered fraction. We pass an
        // explicit 0 in args (count) and 20 in args2 (rpkm/tpm/trimmed_mean),
        // matching the contig-mode policy: count everything mapped, but only
        // call a MAG present for normalized metrics if ≥20% covered.
        ext.args  = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 0"   // count
        ext.args2 = "--min-read-percent-identity 95 --min-read-aligned-percent 75 --min-covered-fraction 20"  // trimmed_mean, rpkm, tpm

        publishDir = [
            path: { "${params.outdir}/abundance/mag/per_batch" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // <class>_NNN.abundance_<metric>.tsv → batch_NNN.<metric>.tsv
                // Mirrors the contig-mode rename in abundance.config so
                // per_batch files look the same across abundance classes.
                return filename.replaceFirst(/^[^_]+(?:\.[^_]+)*_(\d+)\.abundance_([^.]+)\.tsv$/, 'batch_$1.$2.tsv')
            }
        ]
    }

    withName: '.*:DEREPLICATION:.*:COVERM_CONTIG_MERGE' {

        publishDir = [
            path: { "${params.outdir}/abundance/mag" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // cohort_mag_catalog_<metric>_merged.tsv → mag.<metric>.tsv
                // for full consistency with abundance/<class>/<class>.<metric>.tsv
                // (the pattern used by gene_analysis + viral_analysis).
                return filename.replaceFirst(/^cohort_mag_catalog_(\w+)_merged\.tsv$/, 'mag.$1.tsv')
            }
        ]
    }

    // ─── GTDB-Tk on cluster representatives ──────────────────────────────────
    // dRep winners are <sample>_binN.fa (Binette --prefix names propagated
    // through dereplication), so the FASTA suffix is 'fa', not 'fasta'.
    withName: '.*:DEREPLICATION:GTDBTK_CLASSIFYWF' {

        ext.extension = 'fa'

        publishDir = [
            path: { "${params.outdir}/dereplication/gtdbtk" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ─── Cohort catalog summary ──────────────────────────────────────────────
    // mag_catalog.csv is a per-MAG descriptor (cluster_id, lineage, quality,
    // etc.) — belongs with the rest of the MAG catalog artifacts.
    withName: '.*:DEREPLICATION:SUMMARIZE_MAG_CATALOG' {

        publishDir = [
            path: { "${params.outdir}/catalogs/mag" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
