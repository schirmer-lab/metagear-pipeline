/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run schirmer-lab/metagear-pipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Pinned so the versions filename is stable for the snapshot test. It is set
    // here rather than in the test's params block, which collides with nf-test's
    // reserved `workflow` identifier.
    workflow = "test"

    // Input data
    // The pipeline requires one row per sample, so it cannot use viralrecon's sheet
    // unchanged: that one carries SAMPLE3_SE twice, which is how viralrecon tests
    // merging reads split across runs. The same four FASTQs, named as four samples.
    input  = "${projectDir}/assets/samplesheet_test.csv"
}
