// Runs the genes route to completion on the committed mock community.
// What it covers, what it does not, and why: docs/end_to_end_test.md
//
//     nextflow run . -profile test_e2e,singularity --outdir results

// new File(), not Nextflow's file(), which is not callable at config scope.
def e2eDir = "${projectDir}/assets/test_e2e"
def e2eSheet = new File("${launchDir}/.metagear_test_e2e_samplesheet.csv")
e2eSheet.text = new File("${e2eDir}/samplesheet.csv").text.replace('__TEST_E2E_DIR__', e2eDir)

process {
    resourceLimits = [
        cpus: 8,
        memory: '24.GB',
        time: '1.h'
    ]
}

// amrfinder_db is supplied by the site config, so it is declared in neither
// nextflow.config nor the schema and nf-schema calls it invalid on a direct run.
validation {
    ignoreParams = ["amrfinder_db"]
}

params {
    config_profile_name        = 'End-to-end test profile'
    config_profile_description = 'Runs the genes workflow to completion on a committed mock community'

    workflow = "genes"
    input    = e2eSheet.toString()

    representative_proteins_annotations = "${e2eDir}/stub_protein_annotations.tsv"
    amrfinder_db                        = "${e2eDir}/stub_amrfinder_db"
}
